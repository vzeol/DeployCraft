<Project>

  <!-- Settings shared by all projects. -->
  <PropertyGroup>
    <!-- Dependency versions pinned in packages.lock.json (committed): same build everywhere. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- CI restores in locked mode: an outdated lock file makes the build fail. -->
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <!-- Code quality rules of .editorconfig are checked by the build itself (and by CI, where warnings are errors).
         The XML documentation file is needed for the unused-usings check; undocumented members are allowed. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

</Project>
