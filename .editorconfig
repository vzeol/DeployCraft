# Code formatting: applied by `dotnet format DeployCraft.slnx`, checked by CI.
root = true

[*]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,xaml}]
indent_size = 4

[*.{csproj,props,slnx,xml,json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Style du projet : espaces de noms en une ligne, `var` partout, accolades facultatives sur une ligne.
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
csharp_new_line_before_open_brace = all
dotnet_sort_system_directives_first = true

# Code quality checked by every build (CI builds with -warnaserror, so a finding blocks the PR).
# Unused usings.
dotnet_diagnostic.IDE0005.severity = warning
# Method too complex (cyclomatic complexity above 25): split it.
dotnet_diagnostic.CA1502.severity = warning
# A type that owns disposable fields must be disposable.
dotnet_diagnostic.CA1001.severity = warning
# Result of a call ignored (HRESULT, new object…): use it or discard it explicitly with `_ =`.
dotnet_diagnostic.CA1806.severity = warning

[src/DeployCraft.Runner/**.cs]
# The runner files are also compiled into the test project, which has implicit usings: their usings would look
# unused there, while the runner itself (.NET Framework) needs them.
dotnet_diagnostic.IDE0005.severity = none
