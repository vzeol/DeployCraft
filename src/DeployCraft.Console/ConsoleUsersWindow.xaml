<Window x:Class="DeployCraft.Console.ConsoleUsersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Utilisateurs de la console" Height="440" Width="600" MinHeight="320" MinWidth="460"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" IsCancel="True" IsDefault="True">Fermer</Button>
            <TextBlock x:Name="Warning" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
        <TabControl Padding="10">
            <TabItem Header="Utilisateurs">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="AccessHint" Style="{StaticResource Hint}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <StackPanel DockPanel.Dock="Right" Margin="10,0,0,0" Width="150">
                        <Button Style="{StaticResource DialogButton}" Margin="0,0,0,6" HorizontalAlignment="Stretch" Click="Add_Click" x:Name="AddButton">Ajouter…</Button>
                        <Button Style="{StaticResource DialogButton}" Margin="0" HorizontalAlignment="Stretch" Click="Remove_Click" x:Name="RemoveButton">Supprimer</Button>
                    </StackPanel>
                    <ListBox x:Name="List" BorderBrush="{DynamicResource PanelBorder}" DisplayMemberPath="Name" SelectionChanged="List_SelectionChanged" />
                </DockPanel>
            </TabItem>
            <TabItem Header="Sessions actives">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="SessionsCount" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                    <DataGrid x:Name="Sessions">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Utilisateur" Binding="{Binding User}" Width="*" />
                            <DataGridTextColumn Header="Poste" Binding="{Binding Computer}" Width="170" />
                            <DataGridTextColumn Header="Dernière activité" Binding="{Binding LastSeen}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
