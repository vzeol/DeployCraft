<Window x:Class="DeployCraft.Console.DeployWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeployCraft.Console"
        Title="{local:T DeployWindow_Title}" Height="640" Width="1080" MinHeight="460" MinWidth="760"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource DialogButton}" Click="Schedule_Click" x:Name="ScheduleButton"
                        ToolTip="{local:T DeployWindow_ScheduleTip}" Content="{local:T DeployWindow_ScheduleButton}" />
                <Button Style="{StaticResource DialogButton}" Click="Deploy_Click" x:Name="DeployButton" FontWeight="SemiBold" Content="{local:T DeployWindow_DeployNow}" />
                <Button Style="{StaticResource DialogButton}" IsCancel="True" Content="{local:T DeployWindow_Cancel}" />
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="410" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- Volet gauche : paquets puis cibles -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" MinHeight="70" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource DialogButton}" MinWidth="0" Padding="8,3" Click="AddPackage_Click" x:Name="AddPackageButton" Content="{local:T DeployWindow_AddPackage}" />
                        <Button Style="{StaticResource DialogButton}" MinWidth="0" Padding="8,3" Click="PackageUp_Click" ToolTip="{local:T DeployWindow_MoveUp}">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74A;" />
                        </Button>
                        <Button Style="{StaticResource DialogButton}" MinWidth="0" Padding="8,3" Click="PackageDown_Click" ToolTip="{local:T DeployWindow_MoveDown}">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74B;" />
                        </Button>
                        <Button Style="{StaticResource DialogButton}" MinWidth="0" Padding="8,3" Click="RemovePackage_Click" ToolTip="{local:T DeployWindow_RemovePackage}">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74D;" />
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{local:T DeployWindow_Packages}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <ListBox Grid.Row="1" x:Name="PackagesList" MaxHeight="130" BorderBrush="{DynamicResource PanelBorder}"
                         DisplayMemberPath="Display" />
                <TextBlock Grid.Row="2" Style="{StaticResource Hint}" x:Name="PackagesHint"
                           Text="{local:T DeployWindow_PackagesHint}" />

                <TextBlock Grid.Row="3" Text="{local:T DeployWindow_Targets}" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,4" />
                <DockPanel Grid.Row="4" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Click="Choose_Click" x:Name="ChooseButton" Content="{local:T DeployWindow_ChooseTargets}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Active Directory…" Click="Ad_Click" />
                                <MenuItem Header="{local:T DeployWindow_PasteList}" Click="Paste_Click" InputGestureText="Ctrl+V" />
                                <MenuItem Header="{local:T DeployWindow_TextFile}" Click="TextFile_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Click="Add_Click" Content="{local:T DeployWindow_AddButton}" />
                    <TextBox x:Name="ComputerBox" KeyDown="ComputerBox_KeyDown"
                             ToolTip="{local:T DeployWindow_ComputerNameTip}" />
                </DockPanel>

                <DataGrid Grid.Row="5" x:Name="TargetsGrid" SelectionMode="Extended" IsReadOnly="False" CanUserAddRows="False"
                          CanUserDeleteRows="False" KeyDown="Targets_KeyDown">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="34" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CheckIcon}" FontFamily="{StaticResource IconFont}" Foreground="{Binding CheckBrush}"
                                               ToolTip="{Binding CheckTip}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{local:T DeployWindow_ColComputer}" Binding="{Binding Computer}" IsReadOnly="True" Width="*" />
                        <DataGridTemplateColumn Header="{local:T DeployWindow_ColStartStep}" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StepText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox SelectedValue="{Binding StartStep, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Number"
                                              DisplayMemberPath="Text" Padding="4,1"
                                              ItemsSource="{Binding StepChoices, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <DockPanel Grid.Row="6" Margin="0,6,0,0">
                    <Button Style="{StaticResource DialogButton}" Margin="0" Click="Remove_Click" Content="{local:T DeployWindow_RemoveSelection}" />
                    <Button Style="{StaticResource DialogButton}" Click="Clear_Click" HorizontalAlignment="Left" Content="{local:T DeployWindow_RemoveAll}" />
                </DockPanel>
            </Grid>

            <!-- Volet droit : options -->
            <TabControl Grid.Column="2">
                <TabItem Header="{local:T DeployWindow_OptionsTab}">
                    <StackPanel Margin="10">
                        <TextBlock Text="{local:T DeployWindow_Credential}" FontWeight="SemiBold" />
                        <DockPanel Margin="0,4,0,12">
                            <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" MinWidth="0" Margin="6,0,0,0" Click="ManageCredentials_Click"
                                    ToolTip="{local:T DeployWindow_ManageCredentialsTip}" Content="{local:T DeployWindow_Manage}" />
                            <ComboBox x:Name="CredentialBox" SelectionChanged="Option_Changed" />
                        </DockPanel>

                        <TextBlock Text="{local:T DeployWindow_RunAs}" FontWeight="SemiBold" />
                        <ComboBox x:Name="RunAsBox" Margin="0,4,0,2" SelectionChanged="Option_Changed" />
                        <TextBlock x:Name="RunAsHint" Style="{StaticResource Hint}" Margin="0,2,0,12" />

                        <TextBlock Text="{local:T DeployWindow_CopyMode}" FontWeight="SemiBold" />
                        <ComboBox x:Name="CopyModeBox" Margin="0,4,0,2" SelectionChanged="Option_Changed" />
                        <TextBlock x:Name="CopyModeHint" Style="{StaticResource Hint}" Margin="0,2,0,12" />

                        <CheckBox x:Name="RememberBox" Margin="0,0,0,8">
                            <TextBlock TextWrapping="Wrap" Text="{local:T DeployWindow_Remember}" />
                        </CheckBox>
                        <CheckBox x:Name="PriorityBox">
                            <TextBlock TextWrapping="Wrap" Text="{local:T DeployWindow_Priority}" />
                        </CheckBox>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
