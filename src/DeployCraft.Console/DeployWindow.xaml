<Window x:Class="DeployCraft.Console.DeployWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Déployer une fois" Height="640" Width="1080" MinHeight="460" MinWidth="760"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource DialogButton}" Click="Schedule_Click" x:Name="ScheduleButton"
                        ToolTip="Crée une planification avec ces paquets, ces cibles et ces options">Planifier…</Button>
                <Button Style="{StaticResource DialogButton}" Click="Deploy_Click" x:Name="DeployButton" FontWeight="SemiBold">Déployer maintenant</Button>
                <Button Style="{StaticResource DialogButton}" IsCancel="True">Annuler</Button>
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="410" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- Volet gauche : paquets puis cibles -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" MinHeight="70" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource DialogButton}" MinWidth="0" Padding="8,3" Click="AddPackage_Click" x:Name="AddPackageButton">Ajouter un paquet ▾</Button>
                        <Button Style="{StaticResource DialogButton}" MinWidth="0" Padding="8,3" Click="PackageUp_Click" ToolTip="Monter">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74A;" />
                        </Button>
                        <Button Style="{StaticResource DialogButton}" MinWidth="0" Padding="8,3" Click="PackageDown_Click" ToolTip="Descendre">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74B;" />
                        </Button>
                        <Button Style="{StaticResource DialogButton}" MinWidth="0" Padding="8,3" Click="RemovePackage_Click" ToolTip="Retirer le paquet">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74D;" />
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Paquets" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <ListBox Grid.Row="1" x:Name="PackagesList" MaxHeight="130" BorderBrush="{DynamicResource PanelBorder}"
                         DisplayMemberPath="Display" />
                <TextBlock Grid.Row="2" Style="{StaticResource Hint}" x:Name="PackagesHint"
                           Text="Plusieurs paquets : ils s'installent dans cet ordre sur chaque poste, le suivant après la fin du précédent." />

                <TextBlock Grid.Row="3" Text="Cibles" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,4" />
                <DockPanel Grid.Row="4" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Click="Choose_Click" x:Name="ChooseButton">
                        Choisir des cibles ▾
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Active Directory…" Click="Ad_Click" />
                                <MenuItem Header="Coller une liste de postes" Click="Paste_Click" InputGestureText="Ctrl+V" />
                                <MenuItem Header="Fichier texte…" Click="TextFile_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Click="Add_Click">Ajouter</Button>
                    <TextBox x:Name="ComputerBox" KeyDown="ComputerBox_KeyDown"
                             ToolTip="Nom du poste (plusieurs noms possibles, séparés par des espaces, virgules ou retours à la ligne)" />
                </DockPanel>

                <DataGrid Grid.Row="5" x:Name="TargetsGrid" SelectionMode="Extended" IsReadOnly="False" CanUserAddRows="False"
                          CanUserDeleteRows="False" KeyDown="Targets_KeyDown">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="34" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CheckIcon}" FontFamily="{StaticResource IconFont}" Foreground="{Binding CheckBrush}"
                                               ToolTip="{Binding CheckTip}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Poste" Binding="{Binding Computer}" IsReadOnly="True" Width="*" />
                        <DataGridTemplateColumn Header="Démarrer à l'étape" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StepText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox SelectedValue="{Binding StartStep, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Number"
                                              DisplayMemberPath="Text" Padding="4,1"
                                              ItemsSource="{Binding StepChoices, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <DockPanel Grid.Row="6" Margin="0,6,0,0">
                    <Button Style="{StaticResource DialogButton}" Margin="0" Click="Remove_Click">Retirer la sélection</Button>
                    <Button Style="{StaticResource DialogButton}" Click="Clear_Click" HorizontalAlignment="Left">Tout retirer</Button>
                </DockPanel>
            </Grid>

            <!-- Volet droit : options -->
            <TabControl Grid.Column="2">
                <TabItem Header="Options">
                    <StackPanel Margin="10">
                        <TextBlock Text="Identifiant" FontWeight="SemiBold" />
                        <DockPanel Margin="0,4,0,12">
                            <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" MinWidth="0" Margin="6,0,0,0" Click="ManageCredentials_Click"
                                    ToolTip="Ajouter, modifier ou supprimer des identifiants">Gérer…</Button>
                            <ComboBox x:Name="CredentialBox" SelectionChanged="Option_Changed" />
                        </DockPanel>

                        <TextBlock Text="Exécuter en tant que" FontWeight="SemiBold" />
                        <ComboBox x:Name="RunAsBox" Margin="0,4,0,2" SelectionChanged="Option_Changed" />
                        <TextBlock x:Name="RunAsHint" Style="{StaticResource Hint}" Margin="0,2,0,12" />

                        <TextBlock Text="Mode de copie" FontWeight="SemiBold" />
                        <ComboBox x:Name="CopyModeBox" Margin="0,4,0,2" SelectionChanged="Option_Changed" />
                        <TextBlock x:Name="CopyModeHint" Style="{StaticResource Hint}" Margin="0,2,0,12" />

                        <CheckBox x:Name="RememberBox" Margin="0,0,0,8">
                            <TextBlock TextWrapping="Wrap" Text="Mémoriser ces cibles pour ce paquet (proposées au prochain déploiement)" />
                        </CheckBox>
                        <CheckBox x:Name="PriorityBox">
                            <TextBlock TextWrapping="Wrap" Text="Prioritaire : ces postes passent devant ceux qui attendent déjà" />
                        </CheckBox>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
