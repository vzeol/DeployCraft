<Window x:Class="DeployCraft.Console.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeployCraft.Console"
        Title="{local:T ImportWindow_Title}" Height="560" Width="760" MinHeight="380" MinWidth="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" IsCancel="True" Content="{local:T Dialog_Cancel}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" IsDefault="True" Click="Import_Click" x:Name="ImportButton" Content="{local:T ImportWindow_Import}" />
            <TextBlock x:Name="Summary" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" x:Name="FileText" TextWrapping="Wrap" Margin="0,0,0,8" />

        <!-- Folder that replaces $(Repository) in the paths -->
        <DockPanel DockPanel.Dock="Top" x:Name="RepositoryPanel" Margin="0,0,0,8" Visibility="Collapsed">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,4"
                       Text="{local:T ImportWindow_RepositoryHint}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Margin="8,0,0,0" Click="Preview_Click" Content="{local:T ImportWindow_UpdatePreview}" />
            <TextBox x:Name="Repository" VerticalContentAlignment="Center" />
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,6"
                   Text="{local:T ImportWindow_PreviewHint}" />
        <TreeView x:Name="Tree" BorderBrush="{DynamicResource PanelBorder}" Padding="2,4" />
    </DockPanel>
</Window>
