<Window x:Class="DeployCraft.Console.StepsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeployCraft.Console"
        Title="Étapes" Height="560" Width="900" MinHeight="360" MinWidth="600"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False">
    <Window.Resources>
        <local:StatusTextConverter x:Key="StatusText" />
        <local:StatusBrushConverter x:Key="StatusBrush" />
        <local:StatusIconConverter x:Key="StatusIcon" />
    </Window.Resources>
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="&#xE977;" FontFamily="{StaticResource IconFont}" FontSize="26" Foreground="{DynamicResource Accent}"
                       VerticalAlignment="Center" Margin="0,0,10,0" />
            <StackPanel>
                <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="SubHeading" Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
        </StackPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="100" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" MinHeight="100" />
            </Grid.RowDefinitions>
            <DataGrid x:Name="Grid" SelectionChanged="Grid_SelectionChanged" MaxHeight="260">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="N°" Binding="{Binding Number}" Width="40" />
                    <DataGridTextColumn Header="Étape" Binding="{Binding Name}" Width="200" />
                    <DataGridTemplateColumn Header="Statut" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusIcon}}" FontFamily="{StaticResource IconFont}"
                                               Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusText}}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Code retour" Binding="{Binding ReturnCode}" Width="Auto" MinWidth="100" />
                    <DataGridTextColumn Header="Durée" Binding="{Binding Duration}" Width="80" />
                    <DataGridTextColumn Header="Commande" Binding="{Binding CommandLine}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="Transparent" />
            <DockPanel Grid.Row="2">
                <TextBlock DockPanel.Dock="Top" Text="Sortie de l'étape" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="Output" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Background="{DynamicResource AltBackground}"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
