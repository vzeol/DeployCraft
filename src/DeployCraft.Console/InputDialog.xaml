<Window x:Class="DeployCraft.Console.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeployCraft.Console"
        SizeToContent="Height" Width="440" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="Prompt" Margin="0,0,0,8" TextWrapping="Wrap" />
        <TextBox x:Name="Input" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource DialogButton}" IsDefault="True" Click="Ok_Click" FontWeight="SemiBold">OK</Button>
            <Button Style="{StaticResource DialogButton}" IsCancel="True" Content="{local:T Dialog_Cancel}" />
        </StackPanel>
    </StackPanel>
</Window>
