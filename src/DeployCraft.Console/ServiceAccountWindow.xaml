<Window x:Class="DeployCraft.Console.ServiceAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeployCraft.Console"
        Title="{local:T ServiceAccount_Title}" SizeToContent="Height" Width="500" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <RadioButton x:Name="SystemBox" Content="{local:T ServiceAccount_LocalSystem}" Margin="0,0,0,4" Checked="Choice_Changed" />
        <TextBlock Style="{StaticResource Hint}" Margin="22,0,0,10" TextWrapping="Wrap"
                   Text="{local:T ServiceAccount_LocalSystemHint}" />
        <RadioButton x:Name="AccountBox" Content="{local:T ServiceAccount_ThisAccount}" Margin="0,0,0,6" Checked="Choice_Changed" />
        <Grid x:Name="AccountFields" Margin="22,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{local:T ServiceAccount_Account}" />
            <TextBox Grid.Column="1" x:Name="NameBox" Margin="0,0,0,6" ToolTip="{local:T ServiceAccount_NameTip}" />
            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{local:T Dialog_Password}" />
            <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="PasswordBox" Margin="0,0,0,6" />
            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Hint}" TextWrapping="Wrap"
                       Text="{local:T ServiceAccount_AccountHint}" />
            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource WarnBrush}"
                       Text="{local:T ServiceAccount_Warning}" />
        </Grid>
        <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0" TextWrapping="Wrap"
                   Text="{local:T ServiceAccount_RestartWarning}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Style="{StaticResource DialogButton}" IsDefault="True" Click="Ok_Click" Margin="0,0,8,0" Content="{local:T ServiceAccount_Apply}" />
            <Button Style="{StaticResource DialogButton}" IsCancel="True" Content="{local:T Dialog_Cancel}" />
        </StackPanel>
    </StackPanel>
</Window>
