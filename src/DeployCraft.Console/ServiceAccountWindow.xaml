<Window x:Class="DeployCraft.Console.ServiceAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compte du service" SizeToContent="Height" Width="500" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <RadioButton x:Name="SystemBox" Content="Système local (conseillé)" Margin="0,0,0,4" Checked="Choice_Changed" />
        <TextBlock Style="{StaticResource Hint}" Margin="22,0,0,10" TextWrapping="Wrap"
                   Text="Le service est administrateur du serveur ; il utilise le compte de déploiement (Options › Identifiants) pour les postes et les partages." />
        <RadioButton x:Name="AccountBox" Content="Ce compte Windows :" Margin="0,0,0,6" Checked="Choice_Changed" />
        <Grid x:Name="AccountFields" Margin="22,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Compte" />
            <TextBox Grid.Column="1" x:Name="NameBox" Margin="0,0,0,6" ToolTip="DOMAINE\nom, ou .\nom pour un compte local du serveur" />
            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Mot de passe" />
            <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="PasswordBox" Margin="0,0,0,6" />
            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Hint}" TextWrapping="Wrap"
                       Text="Le compte doit être administrateur de ce serveur. Il reçoit le droit d'ouvrir une session en tant que service." />
            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource WarnBrush}"
                       Text="Attention : sous un compte utilisateur, une console ouverte depuis un autre poste peut ne plus se connecter (authentification Windows du domaine). La console de ce serveur, elle, fonctionne toujours. Pour revenir en arrière : Système local." />
        </Grid>
        <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0" TextWrapping="Wrap"
                   Text="Le service redémarre aussitôt sous ce compte : les déploiements en cours sont interrompus." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Style="{StaticResource DialogButton}" IsDefault="True" Click="Ok_Click" Margin="0,0,8,0">Appliquer</Button>
            <Button Style="{StaticResource DialogButton}" IsCancel="True">Annuler</Button>
        </StackPanel>
    </StackPanel>
</Window>
