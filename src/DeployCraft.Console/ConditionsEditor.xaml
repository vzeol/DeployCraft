<UserControl x:Class="DeployCraft.Console.ConditionsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="Intro" Grid.ColumnSpan="3" Style="{StaticResource Hint}" Margin="0,0,0,12" />

            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Version de Windows" VerticalAlignment="Top" Margin="0,2,12,0" />
            <WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">
                <CheckBox x:Name="Win10Box" Content="Windows 10" Margin="0,0,16,4" Click="Changed" />
                <CheckBox x:Name="Win11Box" Content="Windows 11" Margin="0,0,16,4" Click="Changed" />
                <CheckBox x:Name="ServerBox" Content="Windows Server" Margin="0,0,16,4" Click="Changed" />
                <CheckBox x:Name="OlderBox" Content="Versions antérieures" Margin="0,0,16,4" Click="Changed" />
            </WrapPanel>
            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Text="Aucune case cochée : toutes les versions." />

            <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Architecture" />
            <ComboBox Grid.Row="3" Grid.Column="1" x:Name="ArchBox" Margin="0,0,0,8" SelectionChanged="Changed">
                <ComboBoxItem>Toutes</ComboBoxItem>
                <ComboBoxItem>64 bits</ComboBoxItem>
                <ComboBoxItem>32 bits</ComboBoxItem>
            </ComboBox>

            <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="PowerShell" />
            <ComboBox Grid.Row="4" Grid.Column="1" x:Name="PowerShellBox" Margin="0,0,0,8" SelectionChanged="Changed">
                <ComboBoxItem>Indifférent</ComboBoxItem>
                <ComboBoxItem Tag="3">3 ou plus</ComboBoxItem>
                <ComboBoxItem Tag="4">4 ou plus</ComboBoxItem>
                <ComboBoxItem Tag="5">5 ou plus</ComboBoxItem>
                <ComboBoxItem Tag="7">7 ou plus</ComboBoxItem>
            </ComboBox>

            <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="Utilisateur connecté" />
            <ComboBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" x:Name="LoggedOnBox" Margin="0,0,0,8" HorizontalAlignment="Left" MinWidth="260" SelectionChanged="Changed">
                <ComboBoxItem>Indifférent</ComboBoxItem>
                <ComboBoxItem>Quelqu'un doit être connecté</ComboBoxItem>
                <ComboBoxItem>Personne ne doit être connecté</ComboBoxItem>
            </ComboBox>

            <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text="Fichier ou dossier" />
            <ComboBox Grid.Row="6" Grid.Column="1" x:Name="FileBox" Margin="0,0,0,4" SelectionChanged="Changed">
                <ComboBoxItem>Aucune condition</ComboBoxItem>
                <ComboBoxItem>Existe</ComboBoxItem>
                <ComboBoxItem>N'existe pas</ComboBoxItem>
            </ComboBox>
            <TextBox Grid.Row="6" Grid.Column="2" x:Name="FilePathBox" Margin="8,0,0,4" TextChanged="Changed" />
            <TextBlock Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}"
                       Text="Chemin sur le poste ; les variables comme %ProgramFiles% ou %windir% sont acceptées." />

            <TextBlock Grid.Row="8" Style="{StaticResource FieldLabel}" Text="Registre" />
            <ComboBox Grid.Row="8" Grid.Column="1" x:Name="RegistryBox" Margin="0,0,0,4" SelectionChanged="Changed">
                <ComboBoxItem>Aucune condition</ComboBoxItem>
                <ComboBoxItem>Existe</ComboBoxItem>
                <ComboBoxItem>N'existe pas</ComboBoxItem>
            </ComboBox>
            <TextBox Grid.Row="8" Grid.Column="2" x:Name="RegistryKeyBox" Margin="8,0,0,4" TextChanged="Changed" ToolTip="Clé, par exemple HKLM\SOFTWARE\Éditeur\Logiciel" />
            <Grid Grid.Row="9" Grid.Column="2" Margin="8,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Valeur" />
                <TextBox Grid.Column="1" x:Name="RegistryValueBox" TextChanged="Changed" ToolTip="Nom d'une valeur de la clé (facultatif)" />
            </Grid>
            <TextBlock Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}"
                       Text="Clé commençant par HKLM, HKCU, HKCR ou HKU (vue 64 bits sur un poste 64 bits). Valeur vide : seule la clé compte. HKCU désigne le compte qui exécute le paquet." />
        </Grid>
    </ScrollViewer>
</UserControl>
