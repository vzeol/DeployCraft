<UserControl x:Class="DeployCraft.Console.ConditionsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DeployCraft.Console">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="Intro" Grid.ColumnSpan="3" Style="{StaticResource Hint}" Margin="0,0,0,12" />

            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{local:T ConditionsEditor_WindowsVersion}" VerticalAlignment="Top" Margin="0,2,12,0" />
            <WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">
                <CheckBox x:Name="Win10Box" Content="Windows 10" Margin="0,0,16,4" Click="Changed" />
                <CheckBox x:Name="Win11Box" Content="Windows 11" Margin="0,0,16,4" Click="Changed" />
                <CheckBox x:Name="ServerBox" Content="Windows Server" Margin="0,0,16,4" Click="Changed" />
                <CheckBox x:Name="OlderBox" Content="{local:T ConditionsEditor_OlderVersions}" Margin="0,0,16,4" Click="Changed" />
            </WrapPanel>
            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Text="{local:T ConditionsEditor_NoBoxHint}" />

            <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="{local:T ConditionsEditor_Architecture}" />
            <ComboBox Grid.Row="3" Grid.Column="1" x:Name="ArchBox" Margin="0,0,0,8" SelectionChanged="Changed">
                <ComboBoxItem Content="{local:T ConditionsEditor_ArchAll}" />
                <ComboBoxItem Content="{local:T ConditionsEditor_Arch64}" />
                <ComboBoxItem Content="{local:T ConditionsEditor_Arch32}" />
            </ComboBox>

            <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="PowerShell" />
            <ComboBox Grid.Row="4" Grid.Column="1" x:Name="PowerShellBox" Margin="0,0,0,8" SelectionChanged="Changed">
                <ComboBoxItem Content="{local:T ConditionsEditor_Any}" />
                <ComboBoxItem Tag="3" Content="{local:T ConditionsEditor_PowerShell3}" />
                <ComboBoxItem Tag="4" Content="{local:T ConditionsEditor_PowerShell4}" />
                <ComboBoxItem Tag="5" Content="{local:T ConditionsEditor_PowerShell5}" />
                <ComboBoxItem Tag="7" Content="{local:T ConditionsEditor_PowerShell7}" />
            </ComboBox>

            <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="{local:T ConditionsEditor_LoggedOnUser}" />
            <ComboBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" x:Name="LoggedOnBox" Margin="0,0,0,8" HorizontalAlignment="Left" MinWidth="260" SelectionChanged="Changed">
                <ComboBoxItem Content="{local:T ConditionsEditor_Any}" />
                <ComboBoxItem Content="{local:T ConditionsEditor_SomeoneLoggedOn}" />
                <ComboBoxItem Content="{local:T ConditionsEditor_NobodyLoggedOn}" />
            </ComboBox>

            <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text="{local:T ConditionsEditor_FileOrFolder}" />
            <ComboBox Grid.Row="6" Grid.Column="1" x:Name="FileBox" Margin="0,0,0,4" SelectionChanged="Changed">
                <ComboBoxItem Content="{local:T ConditionsEditor_NoCondition}" />
                <ComboBoxItem Content="{local:T ConditionsEditor_Exists}" />
                <ComboBoxItem Content="{local:T ConditionsEditor_NotExists}" />
            </ComboBox>
            <TextBox Grid.Row="6" Grid.Column="2" x:Name="FilePathBox" Margin="8,0,0,4" TextChanged="Changed" />
            <TextBlock Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}"
                       Text="{local:T ConditionsEditor_PathHint}" />

            <TextBlock Grid.Row="8" Style="{StaticResource FieldLabel}" Text="{local:T ConditionsEditor_Registry}" />
            <ComboBox Grid.Row="8" Grid.Column="1" x:Name="RegistryBox" Margin="0,0,0,4" SelectionChanged="Changed">
                <ComboBoxItem Content="{local:T ConditionsEditor_NoCondition}" />
                <ComboBoxItem Content="{local:T ConditionsEditor_Exists}" />
                <ComboBoxItem Content="{local:T ConditionsEditor_NotExists}" />
            </ComboBox>
            <TextBox Grid.Row="8" Grid.Column="2" x:Name="RegistryKeyBox" Margin="8,0,0,4" TextChanged="Changed" ToolTip="{local:T ConditionsEditor_RegistryKeyTip}" />
            <Grid Grid.Row="9" Grid.Column="2" Margin="8,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabel}" Text="{local:T ConditionsEditor_Value}" />
                <TextBox Grid.Column="1" x:Name="RegistryValueBox" TextChanged="Changed" ToolTip="{local:T ConditionsEditor_ValueTip}" />
            </Grid>
            <TextBlock Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}"
                       Text="{local:T ConditionsEditor_RegistryHint}" />
        </Grid>
    </ScrollViewer>
</UserControl>
