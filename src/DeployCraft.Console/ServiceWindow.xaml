<Window x:Class="DeployCraft.Console.ServiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Service en arrière-plan" SizeToContent="Height" Width="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource FieldLabel}" Text="État" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock x:Name="StateIcon" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock x:Name="StateText" VerticalAlignment="Center" TextWrapping="Wrap" />
                <TextBlock x:Name="ServicesLink" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Hyperlink Click="OpenServices_Click">Ouvrir les services Windows</Hyperlink>
                </TextBlock>
            </StackPanel>
            <Button Grid.Row="1" Grid.Column="1" x:Name="RestartButton" Style="{StaticResource DialogButton}" HorizontalAlignment="Left" Margin="0,0,0,14"
                    Click="Restart_Click">Redémarrer le service</Button>
            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Compte" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                <TextBlock x:Name="AccountText" VerticalAlignment="Center" />
                <TextBlock x:Name="ChangeLink" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Hyperlink Click="ChangeAccount_Click">Changer…</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="Hint" Style="{StaticResource Hint}" Margin="0,14,0,0" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="Le service fait tout le travail : déploiements, planifications, bibliothèque de paquets, même console fermée. S'il est arrêté, rien ne part : les déploiements restent en attente." />
        <TextBlock Margin="0,8,0,0"><Hyperlink Click="ConsoleUsers_Click">Utilisateurs de la console…</Hyperlink></TextBlock>
        <Button Style="{StaticResource DialogButton}" HorizontalAlignment="Right" Margin="0,16,0,0" IsCancel="True" IsDefault="True">Fermer</Button>
    </StackPanel>
</Window>
