<!-- Couleurs du thème sombre. Mêmes clés que Clair.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Accent" Color="#F5892B" />
    <SolidColorBrush x:Key="AccentText" Color="#1A1A1A" />
    <SolidColorBrush x:Key="TextBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="MutedBrush" Color="#A8A8A8" />
    <SolidColorBrush x:Key="WindowBackground" Color="#333333" />
    <SolidColorBrush x:Key="ContentBackground" Color="#333333" />
    <SolidColorBrush x:Key="AltBackground" Color="#2B2B2B" />
    <SolidColorBrush x:Key="PanelBorder" Color="#515151" />
    <SolidColorBrush x:Key="GridLineBrush" Color="#444444" />
    <SolidColorBrush x:Key="ToolbarBackground" Color="#3C3C3C" />
    <SolidColorBrush x:Key="HoverBackground" Color="#4A4A4A" />
    <SolidColorBrush x:Key="PressedBackground" Color="#5A5A5A" />
    <SolidColorBrush x:Key="SelectionBackground" Color="#666666" />
    <SolidColorBrush x:Key="BannerBackground" Color="#5A2E2E" />
    <SolidColorBrush x:Key="OkBrush" Color="#66BB6A" />
    <SolidColorBrush x:Key="KoBrush" Color="#EF5350" />
    <SolidColorBrush x:Key="RunBrush" Color="#29B6F6" />
    <!-- Boutons et champs : bordure ≥ 3:1 sur le fond, texte ≥ 4,5:1 (WCAG). Bouton principal = accent. -->
    <SolidColorBrush x:Key="ControlBackground" Color="#3E3E3E" />
    <SolidColorBrush x:Key="ControlHoverBackground" Color="#4D4D4D" />
    <SolidColorBrush x:Key="ControlBorder" Color="#8A8A8A" />
    <SolidColorBrush x:Key="PrimaryBackground" Color="#F5892B" />
    <SolidColorBrush x:Key="PrimaryHoverBackground" Color="#F7A65C" />
    <SolidColorBrush x:Key="PrimaryText" Color="#1A1A1A" />

    <!-- Accent des contrôles Fluent (sélection, focus, cases à cocher) : notre orange au lieu de la couleur de Windows. -->
    <Color x:Key="SystemAccentColor">#E8710A</Color>
    <Color x:Key="SystemAccentColorLight1">#F28A2E</Color>
    <Color x:Key="SystemAccentColorLight2">#F7A65C</Color>
    <Color x:Key="SystemAccentColorLight3">#FBC48F</Color>
    <Color x:Key="SystemAccentColorDark1">#D0650A</Color>
    <Color x:Key="SystemAccentColorDark2">#A04C04</Color>
    <Color x:Key="SystemAccentColorDark3">#7A3A03</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorKey}">#E8710A</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorLight1Key}">#F28A2E</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorLight2Key}">#F7A65C</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorLight3Key}">#FBC48F</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorDark1Key}">#D0650A</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorDark2Key}">#A04C04</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorDark3Key}">#7A3A03</Color>
    <SolidColorBrush x:Key="TreeViewItemSelectionIndicatorForeground" Color="#F5892B" />
    <SolidColorBrush x:Key="ListViewItemPillFillBrush" Color="#F5892B" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#F5892B" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E6F5892B" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CCF5892B" />
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#E8710A" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FBC48F" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FBC48F" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#F7A65C" />
</ResourceDictionary>
