<!-- Couleurs du thème clair. Mêmes clés que Sombre.xaml : toujours les utiliser en DynamicResource. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Accent" Color="#E8710A" />
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextBrush" Color="#1D2330" />
    <SolidColorBrush x:Key="MutedBrush" Color="#5E6575" />
    <SolidColorBrush x:Key="WindowBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ContentBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AltBackground" Color="#FAFBFC" />
    <SolidColorBrush x:Key="PanelBorder" Color="#C9CED6" />
    <SolidColorBrush x:Key="GridLineBrush" Color="#E6E8EC" />
    <SolidColorBrush x:Key="ToolbarBackground" Color="#F5F6F8" />
    <SolidColorBrush x:Key="HoverBackground" Color="#E3EEFA" />
    <SolidColorBrush x:Key="PressedBackground" Color="#CCE0F5" />
    <SolidColorBrush x:Key="SelectionBackground" Color="#CCE0F5" />
    <SolidColorBrush x:Key="BannerBackground" Color="#FDE3E3" />
    <SolidColorBrush x:Key="OkBrush" Color="#1A7F37" />
    <SolidColorBrush x:Key="KoBrush" Color="#C62828" />
    <SolidColorBrush x:Key="RunBrush" Color="#0B62C4" />
    <!-- Boutons et champs : bordure ≥ 3:1 sur le fond, texte ≥ 4,5:1 (WCAG). Bouton principal = orange foncé (texte blanc lisible). -->
    <SolidColorBrush x:Key="ControlBackground" Color="#F6F7F9" />
    <SolidColorBrush x:Key="ControlHoverBackground" Color="#E3EEFA" />
    <SolidColorBrush x:Key="ControlBorder" Color="#8A8F99" />
    <SolidColorBrush x:Key="PrimaryBackground" Color="#B85808" />
    <SolidColorBrush x:Key="PrimaryHoverBackground" Color="#A04C04" />
    <SolidColorBrush x:Key="PrimaryText" Color="#FFFFFF" />

    <!-- Accent des contrôles Fluent (sélection, focus, cases à cocher) : notre orange au lieu de la couleur de Windows. -->
    <Color x:Key="SystemAccentColor">#E8710A</Color>
    <Color x:Key="SystemAccentColorLight1">#F28A2E</Color>
    <Color x:Key="SystemAccentColorLight2">#F7A65C</Color>
    <Color x:Key="SystemAccentColorLight3">#FBC48F</Color>
    <Color x:Key="SystemAccentColorDark1">#D0650A</Color>
    <Color x:Key="SystemAccentColorDark2">#A04C04</Color>
    <Color x:Key="SystemAccentColorDark3">#7A3A03</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorKey}">#E8710A</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorLight1Key}">#F28A2E</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorLight2Key}">#F7A65C</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorLight3Key}">#FBC48F</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorDark1Key}">#D0650A</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorDark2Key}">#A04C04</Color>
    <Color x:Key="{x:Static SystemColors.AccentColorDark3Key}">#7A3A03</Color>
    <SolidColorBrush x:Key="TreeViewItemSelectionIndicatorForeground" Color="#E8710A" />
    <SolidColorBrush x:Key="ListViewItemPillFillBrush" Color="#E8710A" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#D0650A" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E6D0650A" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CCD0650A" />
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#E8710A" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#A04C04" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#7A3A03" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#D0650A" />
</ResourceDictionary>
