<UserControl x:Class="DeployCraft.Console.OfflineEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DeployCraft.Console">
    <StackPanel>
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                   Text="{local:T OfflineEditor_Intro}" />

        <CheckBox x:Name="WakeBox" Content="{local:T OfflineEditor_Wake}" Click="Changed" />
        <StackPanel Orientation="Horizontal" Margin="24,6,0,0">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{local:T OfflineEditor_WakeWait}" />
            <TextBox x:Name="WakeMinutesBox" Style="{StaticResource CompactBox}" Width="50" TextChanged="Changed" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="{local:T OfflineEditor_Minutes}" Margin="6,0,0,0" />
        </StackPanel>
        <TextBlock Style="{StaticResource Hint}" Margin="24,4,0,14"
                   Text="{local:T OfflineEditor_WakeHint}" />

        <CheckBox x:Name="RetryBox" Content="{local:T OfflineEditor_Retry}" Click="Changed" />
        <StackPanel Orientation="Horizontal" Margin="24,6,0,0">
            <TextBox x:Name="AttemptsBox" Style="{StaticResource CompactBox}" Width="50" TextChanged="Changed" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="{local:T OfflineEditor_Attempts}" Margin="6,0,6,0" />
            <TextBox x:Name="IntervalBox" Style="{StaticResource CompactBox}" Width="50" TextChanged="Changed" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="{local:T OfflineEditor_Minutes}" Margin="6,0,0,0" />
        </StackPanel>
        <TextBlock Style="{StaticResource Hint}" Margin="24,4,0,0"
                   Text="{local:T OfflineEditor_RetryHint}" />
    </StackPanel>
</UserControl>
