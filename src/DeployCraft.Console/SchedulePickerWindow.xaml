<Window x:Class="DeployCraft.Console.SchedulePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajouter à une planification" Height="380" Width="460" MinHeight="260" MinWidth="360"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" x:Name="Prompt" TextWrapping="Wrap" Margin="0,0,0,8" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource DialogButton}" IsDefault="True" Click="Ok_Click" x:Name="OkButton" Margin="0,0,8,0">Ajouter</Button>
            <Button Style="{StaticResource DialogButton}" IsCancel="True">Annuler</Button>
        </StackPanel>
        <ListBox x:Name="List" DisplayMemberPath="Name" BorderBrush="{DynamicResource PanelBorder}"
                 SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_MouseDoubleClick" />
    </DockPanel>
</Window>
