<Window x:Class="DeployCraft.Console.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bienvenue dans DeployCraft" SizeToContent="Height" Width="620" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False">
    <StackPanel Margin="22,18,22,14">
        <TextBlock Text="Bienvenue dans DeployCraft" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,16"
                   Text="Quelques réglages avant le premier déploiement. Chaque étape ouvre la fenêtre qui convient ; vous pouvez revenir ici à tout moment par Aide › Assistant de démarrage." />

        <TextBlock x:Name="ServiceWarning" Foreground="{DynamicResource KoBrush}" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed" />

        <ItemsControl x:Name="Steps">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,10"
                            Background="{DynamicResource ContentBackground}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Mark}" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{Binding MarkBrush}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Text}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource DialogButton}" Content="{Binding Action}" Click="Step_Click"
                                    VerticalAlignment="Center" Margin="0" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <DockPanel Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" IsCancel="True" IsDefault="True">Fermer</Button>
            <TextBlock x:Name="Progress" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
        </DockPanel>
    </StackPanel>
</Window>
