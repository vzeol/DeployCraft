<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console DeployCraft : l'application fenêtrée qui pilote le service DeployCraft. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Publié en win-x64 autonome (build.ps1) : le lock file inclut ce runtime. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>DeployCraft</AssemblyName>
    <RootNamespace>DeployCraft.Console</RootNamespace>
  </PropertyGroup>

  <!-- Même modèle de données que le service. -->
  <ItemGroup>
    <Compile Include="..\DeployCraft.Server\Data\Models.cs" Link="Shared\Models.cs" />
    <Compile Include="..\DeployCraft.Server\Data\TriggerCalendar.cs" Link="Shared\TriggerCalendar.cs" />
    <Compile Include="..\DeployCraft.Server\Data\ExchangeModels.cs" Link="Shared\ExchangeModels.cs" />
    <Compile Include="..\DeployCraft.Server\Data\LibraryModels.cs" Link="Shared\LibraryModels.cs" />
    <Compile Include="..\DeployCraft.Server\Data\AboutInfo.cs" Link="Shared\AboutInfo.cs" />
    <Compile Include="..\DeployCraft.Server\Data\UpdateInfo.cs" Link="Shared\UpdateInfo.cs" />
    <Compile Include="..\DeployCraft.Server\Data\InstallCommand.cs" Link="Shared\InstallCommand.cs" />
    <Compile Include="..\DeployCraft.Server\Data\DeploymentSummary.cs" Link="Shared\DeploymentSummary.cs" />
    <Compile Include="..\DeployCraft.Server\Data\StepWarnings.cs" Link="Shared\StepWarnings.cs" />
    <Compile Include="..\DeployCraft.Server\Data\HomeSummary.cs" Link="Shared\HomeSummary.cs" />
    <Compile Include="..\DeployCraft.Server\Data\HelpContent.cs" Link="Shared\HelpContent.cs" />
  </ItemGroup>

  <!-- Aide intégrée (Aide › Aide de DeployCraft, F1). -->
  <ItemGroup>
    <Resource Include="Help\aide.txt" />
  </ItemGroup>

</Project>
