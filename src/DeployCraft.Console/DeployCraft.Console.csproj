<Project Sdk="Microsoft.NET.Sdk">

  <!-- DeployCraft Console: the windowed application that drives the DeployCraft service. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Published as self-contained win-x64 (build.ps1): the lock file includes this runtime. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>DeployCraft</AssemblyName>
    <RootNamespace>DeployCraft.Console</RootNamespace>
  </PropertyGroup>

  <!-- Same data model as the service. -->
  <ItemGroup>
    <Compile Include="..\DeployCraft.Server\Data\Models.cs" Link="Shared\Models.cs" />
    <Compile Include="..\DeployCraft.Server\Data\TriggerCalendar.cs" Link="Shared\TriggerCalendar.cs" />
    <Compile Include="..\DeployCraft.Server\Data\ExchangeModels.cs" Link="Shared\ExchangeModels.cs" />
    <Compile Include="..\DeployCraft.Server\Data\LibraryModels.cs" Link="Shared\LibraryModels.cs" />
    <Compile Include="..\DeployCraft.Server\Data\AboutInfo.cs" Link="Shared\AboutInfo.cs" />
    <Compile Include="..\DeployCraft.Server\Data\UpdateInfo.cs" Link="Shared\UpdateInfo.cs" />
    <Compile Include="..\DeployCraft.Server\Data\InstallCommand.cs" Link="Shared\InstallCommand.cs" />
    <Compile Include="..\DeployCraft.Server\Data\DeploymentSummary.cs" Link="Shared\DeploymentSummary.cs" />
    <Compile Include="..\DeployCraft.Server\Data\StepWarnings.cs" Link="Shared\StepWarnings.cs" />
    <Compile Include="..\DeployCraft.Server\Data\HomeSummary.cs" Link="Shared\HomeSummary.cs" />
    <Compile Include="..\DeployCraft.Server\Data\HelpContent.cs" Link="Shared\HelpContent.cs" />
    <Compile Include="..\DeployCraft.Server\Data\PackageDetails.cs" Link="Shared\PackageDetails.cs" />
    <!-- Texts of the shared models, in the console language. -->
    <Compile Include="..\DeployCraft.Server\Texts\Msg.cs" Link="Shared\Msg.cs" />
    <EmbeddedResource Include="..\DeployCraft.Server\Texts\Msg.resx" Link="Shared\Msg.resx" />
    <EmbeddedResource Include="..\DeployCraft.Server\Texts\Msg.en.resx" Link="Shared\Msg.en.resx" />
  </ItemGroup>

  <!-- Console texts: Resources\Strings.resx in French (default language), Strings.en.resx in English.
       Read through L.Get / L.Format in C# and {local:T Key} in XAML (UiLanguage.cs). -->
  <PropertyGroup>
    <NeutralLanguage>fr</NeutralLanguage>
  </PropertyGroup>

  <!-- Built-in help (Help › DeployCraft help, F1), in French and English. -->
  <ItemGroup>
    <Resource Include="Help\aide.txt" />
    <Resource Include="Help\aide.en.txt" />
  </ItemGroup>

</Project>
