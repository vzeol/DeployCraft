<Window x:Class="DeployCraft.Console.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Height" Width="460" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False">
    <StackPanel Margin="18,16,18,14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Glyph" FontSize="28" Margin="0,0,14,0" VerticalAlignment="Top" />
            <!-- Texte sélectionnable (Ctrl+C) : utile pour copier un message d'erreur. -->
            <TextBox x:Name="Message" Grid.Column="1" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Padding="0"
                     Background="Transparent" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"
                     MaxHeight="420" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Message" />
        </Grid>
        <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0" />
    </StackPanel>
</Window>
