<Window x:Class="DeployCraft.Console.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeployCraft.Console"
        Title="Préférences" Height="500" Width="760" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False">
    <Window.Resources>
        <!-- Pages en liste à gauche : la page choisie est surlignée en orange. -->
        <Style x:Key="PageItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="10,5">
                            <ContentPresenter x:Name="Hd" ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Hd" Property="TextElement.Foreground" Value="{DynamicResource AccentText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel Margin="14">
        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Style="{StaticResource DialogButton}" IsCancel="True" Margin="0,12,0,0">Fermer</Button>
        <TabControl x:Name="Tabs" TabStripPlacement="Left" ItemContainerStyle="{StaticResource PageItem}"
                    Background="Transparent" BorderThickness="0">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="170" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" Padding="0,2">
                            <StackPanel IsItemsHost="True" />
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="16,2,0,0" />
                    </DockPanel>
                </ControlTemplate>
            </TabControl.Template>

            <!-- Interface -->
            <TabItem Header="Interface">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Thème" />
                        <ComboBox Grid.Column="1" x:Name="ThemeBox" SelectionChanged="Theme_Changed">
                            <ComboBoxItem Tag="Clair">Clair</ComboBoxItem>
                            <ComboBoxItem Tag="Sombre">Sombre</ComboBoxItem>
                            <ComboBoxItem Tag="Windows">Selon Windows</ComboBoxItem>
                        </ComboBox>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Margin="110,6,0,0"
                               Text="S'applique tout de suite à toutes les fenêtres. « Selon Windows » suit le mode clair ou sombre choisi dans les paramètres de Windows. Réglage propre à votre session Windows." />
                </StackPanel>
            </TabItem>

            <!-- Déploiement : valeurs des paquets laissés « par défaut » -->
            <TabItem Header="Déploiement">
                <Grid x:Name="DeploymentPage" IsEnabled="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.ColumnSpan="2" Style="{StaticResource Hint}" Margin="0,0,0,12"
                               Text="Valeurs des paquets dont le réglage est laissé « Par défaut ». Réglage du serveur, commun à toutes les consoles, enregistré à la fermeture de cette fenêtre." />
                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Exécuter en tant que" />
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="DefaultRunAsBox" Margin="0,0,0,8" HorizontalAlignment="Left" MinWidth="260" />
                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Mode de copie" />
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="DefaultCopyModeBox" Margin="0,0,0,8" HorizontalAlignment="Left" MinWidth="260" />
                    <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Délai max (minutes)" />
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="DefaultTimeoutBox" Style="{StaticResource CompactBox}" HorizontalAlignment="Left" Width="70" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Hint}" Text="Par étape : au-delà, le processus est arrêté et l'étape échoue." />
                </Grid>
            </TabItem>

            <!-- Hors ligne -->
            <TabItem Header="Hors ligne">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                   Text="Réglages des paquets qui suivent les Préférences (onglet Hors ligne du paquet)." />
                        <local:OfflineEditor x:Name="DefaultOffline" IsEnabled="False" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
