<Window x:Class="DeployCraft.Console.ScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeployCraft.Console"
        Title="{local:T ScheduleWindow_Title}" Height="680" Width="960" MinHeight="500" MinWidth="820"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="TabIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Small" TargetType="TextBox" BasedOn="{StaticResource CompactBox}">
            <Setter Property="Width" Value="60" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
        <Style x:Key="Unit" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,10,0" />
        </Style>
        <Style x:Key="Row" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="EditorLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="70" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource DialogButton}" Click="Ok_Click" IsDefault="True" FontWeight="SemiBold">OK</Button>
                <Button Style="{StaticResource DialogButton}" IsCancel="True" Content="{local:T ScheduleWindow_Cancel}" />
            </StackPanel>
        </DockPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="{local:T ScheduleWindow_Name}" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="NameBox" />
        </DockPanel>

        <TabControl x:Name="Tabs">
            <!-- Triggers -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                        <TextBlock Style="{StaticResource TabIcon}" Text="&#xE823;" />
                        <TextBlock Text="{local:T ScheduleWindow_TriggersTab}" />
                    </StackPanel>
                </TabItem.Header>
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Style="{StaticResource ToolButton}" Tag="&#xE8BF;" Click="AddOnce_Click" Content="{local:T ScheduleWindow_AddOnce}" />
                        <Button Style="{StaticResource ToolButton}" Tag="&#xE916;" Click="AddInterval_Click" Content="{local:T ScheduleWindow_AddInterval}" />
                        <Button Style="{StaticResource ToolButton}" Tag="&#xE787;" Click="AddDaily_Click" Content="{local:T ScheduleWindow_AddDaily}" />
                        <Button Style="{StaticResource ToolButton}" Tag="&#xE8C0;" Click="AddWeekly_Click" Content="{local:T ScheduleWindow_AddWeekly}" />
                        <Button Style="{StaticResource ToolButton}" Tag="&#xE8BF;" Click="AddMonthly_Click" Content="{local:T ScheduleWindow_AddMonthly}" />
                        <Border Style="{StaticResource ToolSeparator}" />
                        <Button Style="{StaticResource ToolButton}" Tag="&#xE8C8;" Click="DuplicateTrigger_Click" x:Name="DuplicateTriggerButton" Content="{local:T ScheduleWindow_Duplicate}" />
                        <Button Style="{StaticResource ToolButton}" Tag="&#xE74D;" Click="DeleteTrigger_Click" x:Name="DeleteTriggerButton" Content="{local:T ScheduleWindow_Delete}" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="400" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <ListBox x:Name="TriggersList" SelectionChanged="TriggersList_SelectionChanged" BorderBrush="{DynamicResource PanelBorder}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="2,4" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="NoTriggerText" Style="{StaticResource Hint}" Margin="14" IsHitTestVisible="False"
                                       Text="{local:T ScheduleWindow_NoTrigger}" />
                        </Grid>

                        <Border Grid.Column="2" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="4" Padding="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="Editor">
                                    <TextBlock x:Name="EditorTitle" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <CheckBox x:Name="TrigEnabled" Content="{local:T ScheduleWindow_TriggerEnabled}" Margin="0,0,0,12" Click="Editor_Changed" />

                                    <!-- Intervalle -->
                                    <StackPanel x:Name="IntervalPanel">
                                        <StackPanel Style="{StaticResource Row}">
                                            <TextBlock Text="{local:T ScheduleWindow_Every}" Style="{StaticResource EditorLabel}" />
                                            <TextBox x:Name="IntDays" Style="{StaticResource Small}" TextChanged="Editor_Changed" />
                                            <TextBlock Text="{local:T ScheduleWindow_UnitDays}" Style="{StaticResource Unit}" />
                                            <TextBox x:Name="IntHours" Style="{StaticResource Small}" TextChanged="Editor_Changed" />
                                            <TextBlock Text="{local:T ScheduleWindow_UnitHours}" Style="{StaticResource Unit}" />
                                            <TextBox x:Name="IntMinutes" Style="{StaticResource Small}" TextChanged="Editor_Changed" />
                                            <TextBlock Text="{local:T ScheduleWindow_UnitMinutes}" Style="{StaticResource Unit}" />
                                        </StackPanel>
                                        <CheckBox x:Name="WindowBox" Content="{local:T ScheduleWindow_OnlyInWindow}" Click="Editor_Changed" Margin="0,0,0,6" />
                                        <StackPanel Style="{StaticResource Row}" Margin="22,0,0,12">
                                            <TextBlock Text="{local:T ScheduleWindow_Between}" Style="{StaticResource Unit}" Margin="0,0,8,0" />
                                            <TextBox x:Name="WinFrom" Style="{StaticResource CompactBox}" Width="70" TextChanged="Editor_Changed" ToolTip="HH:mm" />
                                            <TextBlock Text="{local:T ScheduleWindow_And}" Style="{StaticResource Unit}" Margin="8,0" />
                                            <TextBox x:Name="WinTo" Style="{StaticResource CompactBox}" Width="70" TextChanged="Editor_Changed" ToolTip="HH:mm" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Hebdomadaire -->
                                    <StackPanel x:Name="WeeklyPanel">
                                        <TextBlock Text="{local:T ScheduleWindow_EveryWeekOn}" Margin="0,0,0,6" />
                                        <WrapPanel x:Name="DaysPanel" Margin="0,0,0,12" />
                                    </StackPanel>

                                    <!-- Mensuel -->
                                    <StackPanel x:Name="MonthlyPanel" Margin="0,0,0,6">
                                        <TextBlock Text="{local:T ScheduleWindow_EveryMonth}" Margin="0,0,0,6" />
                                        <StackPanel Style="{StaticResource Row}">
                                            <RadioButton x:Name="MonthByDay" GroupName="Month" Content="{local:T ScheduleWindow_TheDay}" Width="90" VerticalAlignment="Center" Click="Editor_Changed" />
                                            <ComboBox x:Name="MonthDayBox" Width="150" SelectionChanged="Editor_Changed" />
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource Row}">
                                            <RadioButton x:Name="MonthByWeek" GroupName="Month" Content="{local:T ScheduleWindow_The}" Width="90" VerticalAlignment="Center" Click="Editor_Changed" />
                                            <ComboBox x:Name="MonthWeekBox" Width="110" SelectionChanged="Editor_Changed" />
                                            <ComboBox x:Name="MonthWeekDayBox" Width="110" Margin="6,0,0,0" SelectionChanged="Editor_Changed" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Start / end -->
                                    <StackPanel Style="{StaticResource Row}">
                                        <TextBlock x:Name="StartLabel" Text="{local:T ScheduleWindow_Begin}" Style="{StaticResource EditorLabel}" />
                                        <DatePicker x:Name="StartDate" Width="150" SelectedDateChanged="Editor_Changed" />
                                        <TextBlock Text="{local:T ScheduleWindow_At}" Style="{StaticResource Unit}" Margin="8,0" />
                                        <TextBox x:Name="StartTime" Style="{StaticResource CompactBox}" Width="70" TextChanged="Editor_Changed" ToolTip="HH:mm" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Row}" x:Name="EndPanel">
                                        <CheckBox x:Name="EndBox" Content="{local:T ScheduleWindow_End}" Width="70" VerticalAlignment="Center" Click="Editor_Changed" />
                                        <DatePicker x:Name="EndDate" Width="150" SelectedDateChanged="Editor_Changed" />
                                        <TextBlock Text="{local:T ScheduleWindow_At}" Style="{StaticResource Unit}" Margin="8,0" />
                                        <TextBox x:Name="EndTime" Style="{StaticResource CompactBox}" Width="70" TextChanged="Editor_Changed" ToolTip="HH:mm" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Row}">
                                        <TextBlock Text="{local:T ScheduleWindow_Note}" Style="{StaticResource EditorLabel}" />
                                        <TextBox x:Name="DescriptionBox" Width="260" TextChanged="Editor_Changed" ToolTip="{local:T ScheduleWindow_Optional}" />
                                    </StackPanel>
                                    <TextBlock x:Name="NextText" Style="{StaticResource Hint}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- Cibles -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                        <TextBlock Style="{StaticResource TabIcon}" Text="&#xE7F8;" />
                        <TextBlock Text="{local:T ScheduleWindow_TargetsTab}" />
                    </StackPanel>
                </TabItem.Header>
                <DockPanel Margin="8">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Click="Choose_Click" x:Name="ChooseButton" Content="{local:T ScheduleWindow_ChooseTargets}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Active Directory…" Click="Ad_Click" />
                                    <MenuItem Header="{local:T ScheduleWindow_PasteList}" Click="Paste_Click" InputGestureText="Ctrl+V" />
                                    <MenuItem Header="{local:T ScheduleWindow_TextFile}" Click="TextFile_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Click="Add_Click" Content="{local:T ScheduleWindow_AddButton}" />
                        <TextBox x:Name="ComputerBox" KeyDown="ComputerBox_KeyDown"
                                 ToolTip="{local:T ScheduleWindow_ComputerNameTip}" />
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <TextBlock x:Name="TargetsCount" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                        <Button Style="{StaticResource DialogButton}" Margin="0" Click="Remove_Click" Content="{local:T ScheduleWindow_RemoveSelection}" />
                        <Button Style="{StaticResource DialogButton}" Click="Clear_Click" HorizontalAlignment="Left" Content="{local:T ScheduleWindow_RemoveAll}" />
                    </DockPanel>
                    <ListBox x:Name="TargetsList" SelectionMode="Extended" BorderBrush="{DynamicResource PanelBorder}" KeyDown="Targets_KeyDown" />
                </DockPanel>
            </TabItem>

            <!-- Paquets -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                        <TextBlock Style="{StaticResource TabIcon}" Text="&#xE7B8;" />
                        <TextBlock Text="{local:T ScheduleWindow_PackagesTab}" />
                    </StackPanel>
                </TabItem.Header>
                <DockPanel Margin="8">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource DialogButton}" MinWidth="0" Padding="8,3" Click="AddPackage_Click" x:Name="AddPackageButton" Content="{local:T ScheduleWindow_AddPackage}" />
                            <Button Style="{StaticResource DialogButton}" MinWidth="0" Padding="8,3" Click="PackageUp_Click" ToolTip="{local:T ScheduleWindow_MoveUp}">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74A;" />
                            </Button>
                            <Button Style="{StaticResource DialogButton}" MinWidth="0" Padding="8,3" Click="PackageDown_Click" ToolTip="{local:T ScheduleWindow_MoveDown}">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74B;" />
                            </Button>
                            <Button Style="{StaticResource DialogButton}" MinWidth="0" Padding="8,3" Click="RemovePackage_Click" ToolTip="{local:T ScheduleWindow_RemovePackage}">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74D;" />
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="PackagesCount" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,6,0,0"
                               Text="{local:T ScheduleWindow_PackagesOrder}" />
                    <ListBox x:Name="PackagesList" DisplayMemberPath="Display" BorderBrush="{DynamicResource PanelBorder}" />
                </DockPanel>
            </TabItem>

            <!-- Options -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                        <TextBlock Style="{StaticResource TabIcon}" Text="&#xE713;" />
                        <TextBlock Text="{local:T ScheduleWindow_OptionsTab}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14" MaxWidth="640" HorizontalAlignment="Left">
                        <CheckBox x:Name="EnabledBox" Content="{local:T ScheduleWindow_ScheduleEnabled}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                                   Text="{local:T ScheduleWindow_DisabledHint}" />

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{local:T ScheduleWindow_Credential}" Style="{StaticResource FieldLabel}" />
                            <DockPanel Grid.Column="1" Margin="0,4">
                                <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" MinWidth="0" Margin="6,0,0,0" Click="ManageCredentials_Click"
                                        ToolTip="{local:T ScheduleWindow_ManageCredentialsTip}" Content="{local:T ScheduleWindow_Manage}" />
                                <ComboBox x:Name="CredentialBox" />
                            </DockPanel>
                            <TextBlock Grid.Row="1" Text="{local:T ScheduleWindow_RunAs}" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="RunAsBox" Margin="0,4" />
                            <TextBlock Grid.Row="2" Text="{local:T ScheduleWindow_CopyMode}" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CopyModeBox" Margin="0,4" />
                        </Grid>

                        <CheckBox x:Name="StopOnSuccessBox" Margin="0,0,0,2">
                            <TextBlock Text="{local:T ScheduleWindow_StopOnSuccess}" />
                        </CheckBox>
                        <TextBlock Style="{StaticResource Hint}" Margin="22,0,0,10"
                                   Text="{local:T ScheduleWindow_StopOnSuccessHint}" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox x:Name="StopFailBox" VerticalAlignment="Center" Click="Options_Click">
                                <TextBlock Text="{local:T ScheduleWindow_StopAfter}" />
                            </CheckBox>
                            <TextBox x:Name="FailCountBox" Style="{StaticResource Small}" Margin="8,0" />
                            <TextBlock Text="{local:T ScheduleWindow_Failures}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <CheckBox x:Name="QueueBox" VerticalAlignment="Center" Click="Options_Click">
                                <TextBlock Text="{local:T ScheduleWindow_AbandonAfter}" />
                            </CheckBox>
                            <TextBox x:Name="QueueMinutesBox" Style="{StaticResource Small}" Margin="8,0" />
                            <TextBlock Text="{local:T ScheduleWindow_Minutes}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="22,0,0,10"
                                   Text="{local:T ScheduleWindow_QueueHint}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Target history -->
            <TabItem x:Name="HistoryTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                        <TextBlock Style="{StaticResource TabIcon}" Text="&#xE81C;" />
                        <TextBlock Text="{local:T ScheduleWindow_HistoryTab}" />
                    </StackPanel>
                </TabItem.Header>
                <DockPanel Margin="8">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource DialogButton}" Click="ClearHistory_Click" Content="{local:T ScheduleWindow_ClearSelection}" />
                            <Button Style="{StaticResource DialogButton}" Click="ClearAllHistory_Click" Content="{local:T ScheduleWindow_ClearAll}" />
                            <Button Style="{StaticResource DialogButton}" MinWidth="0" Click="RefreshHistory_Click" ToolTip="{local:T ScheduleWindow_Refresh}">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72C;" />
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="HistoryCount" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,6,0,0" x:Name="HistoryHint"
                               Text="{local:T ScheduleWindow_HistoryHint}" />
                    <DataGrid x:Name="HistoryGrid" SelectionMode="Extended">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{local:T ScheduleWindow_ColComputer}" Binding="{Binding Computer}" Width="*" />
                            <DataGridTextColumn Header="{local:T ScheduleWindow_ColPackage}" Binding="{Binding PackageName}" Width="*" />
                            <DataGridTemplateColumn Header="{local:T ScheduleWindow_ColSucceeded}" Width="80" SortMemberPath="Succeeded">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SuccessIcon}" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource OkBrush}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{local:T ScheduleWindow_ColFailures}" Binding="{Binding Failures}" Width="80" />
                            <DataGridTextColumn Header="{local:T ScheduleWindow_ColLastAttempt}" Binding="{Binding Last}" Width="150" SortMemberPath="LastUtc" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
