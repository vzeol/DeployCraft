<Window x:Class="DeployCraft.Console.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeployCraft.Console"
        Title="DeployCraft" Height="820" Width="1360" MinHeight="520" MinWidth="980"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <!-- View header: big icon + title + subtitle -->
        <Style x:Key="ViewIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="2,0,12,0" />
        </Style>
        <Style x:Key="ViewTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ViewSubtitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <!-- Home page: cards -->
        <Style x:Key="HomeCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ContentBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Width" Value="330" />
        </Style>
        <Style x:Key="HomeCardTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="HomeNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Menu -->
        <Menu DockPanel.Dock="Top" Padding="2">
            <MenuItem Header="{local:T MainWindow_MenuFile}" SubmenuOpened="Menu_Opened">
                <MenuItem Header="{local:T MainWindow_MenuNewPackage}" Click="NewPackage_Click" InputGestureText="Ctrl+N" x:Name="MenuNewPackage" />
                <MenuItem Header="{local:T MainWindow_MenuNewFolder}" Click="NewFolder_Click" InputGestureText="{local:T MainWindow_KeyCtrlShiftF}" x:Name="MenuNewFolder" />
                <Separator />
                <MenuItem Header="{local:T MainWindow_MenuDuplicate}" Click="Duplicate_Click" InputGestureText="{local:T MainWindow_KeyAltInsert}" x:Name="MenuDuplicate" />
                <MenuItem Header="{local:T MainWindow_MenuEditPackage}" Click="EditPackage_Click" InputGestureText="Ctrl+O" x:Name="MenuOpen" />
                <Separator />
                <MenuItem Header="{local:T MainWindow_MenuDeployOnce}" Click="DeployOnce_Click" InputGestureText="Ctrl+D" x:Name="MenuDeployOnce" />
                <MenuItem Header="{local:T MainWindow_MenuNewSchedule}" Click="NewSchedule_Click" InputGestureText="{local:T MainWindow_KeyCtrlShiftN}" x:Name="MenuNewSchedule" />
                <Separator />
                <MenuItem Header="{local:T MainWindow_MenuImport}" Click="Import_Click" x:Name="MenuImport" />
                <MenuItem Header="{local:T MainWindow_MenuExport}" Click="ExportPackage_Click" x:Name="MenuExport" />
                <MenuItem Header="{local:T MainWindow_MenuExportAll}" Click="ExportAll_Click" x:Name="MenuExportAll" />
                <Separator />
                <MenuItem Header="{local:T MainWindow_MenuQuit}" Click="Exit_Click" InputGestureText="Alt+F4" />
            </MenuItem>
            <MenuItem Header="{local:T MainWindow_MenuEdit}" SubmenuOpened="Menu_Opened" x:Name="MenuEdit">
                <MenuItem Header="{local:T MainWindow_MenuCancelDeployment}" Click="Abort_Click" x:Name="MenuAbort" />
                <Separator />
                <MenuItem Header="{local:T MainWindow_MenuRedeploy}" Click="Redeploy_Click" InputGestureText="Ctrl+R" x:Name="MenuRedeploy" />
                <MenuItem Header="{local:T MainWindow_MenuRedeployFailed}" Click="RedeployFailed_Click" InputGestureText="{local:T MainWindow_KeyCtrlShiftR}" x:Name="MenuRedeployFailed" />
                <MenuItem Header="{local:T MainWindow_MenuRedeployFromStep}" Click="RedeployFromStep_Click" x:Name="MenuRedeployFromStep" />
                <Separator />
                <MenuItem Header="{local:T MainWindow_MenuDelete}" Click="Delete_Click" InputGestureText="{local:T MainWindow_KeyDelete}" x:Name="MenuDelete" />
                <MenuItem Header="{local:T MainWindow_MenuRename}" Click="Rename_Click" InputGestureText="F2" x:Name="MenuRename" />
            </MenuItem>
            <MenuItem Header="{local:T MainWindow_MenuView}" x:Name="MenuView">
                <MenuItem Header="{local:T MainWindow_MenuHome}" Click="ViewHome_Click" InputGestureText="Ctrl+0" />
                <MenuItem Header="{local:T MainWindow_MenuAllDeployments}" Click="ViewDeployments_Click" InputGestureText="Ctrl+1" />
                <MenuItem Header="{local:T MainWindow_MenuAllSchedules}" Click="ViewSchedules_Click" InputGestureText="Ctrl+2" />
                <MenuItem Header="{local:T MainWindow_MenuLibrary}" Click="ViewLibrary_Click" InputGestureText="Ctrl+3" />
                <MenuItem Header="{local:T MainWindow_MenuPackages}" Click="ViewPackages_Click" InputGestureText="Ctrl+4" />
                <Separator />
                <MenuItem Header="{local:T MainWindow_MenuFindPackage}" Click="ViewFilter_Click" InputGestureText="Ctrl+F" />
                <MenuItem Header="{local:T MainWindow_MenuRefresh}" Click="Refresh_Click" InputGestureText="F5" />
            </MenuItem>
            <MenuItem Header="{local:T MainWindow_MenuOptions}" x:Name="MenuOptions">
                <MenuItem Header="{local:T MainWindow_MenuCredentials}" Click="Credentials_Click" />
                <MenuItem Header="{local:T MainWindow_MenuConsoleUsers}" Click="ConsoleUsers_Click" />
                <MenuItem Header="{local:T MainWindow_MenuBackgroundService}" Click="BackgroundService_Click" />
                <Separator />
                <MenuItem Header="{local:T MainWindow_MenuPreferences}" Click="Settings_Click" InputGestureText="Ctrl+," />
            </MenuItem>
            <MenuItem Header="{local:T MainWindow_MenuHelp}">
                <MenuItem Header="{local:T MainWindow_MenuHelpContents}" Click="Help_Click" InputGestureText="F1" />
                <Separator />
                <MenuItem Header="{local:T MainWindow_MenuAdminCmd}" Click="AdminCmd_Click" />
                <MenuItem Header="{local:T MainWindow_MenuAdminPowerShell}" Click="AdminPowerShell_Click" />
                <Separator />
                <MenuItem Header="{local:T MainWindow_MenuWelcome}" Click="Welcome_Click" />
                <Separator />
                <MenuItem Header="{local:T MainWindow_MenuCheckUpdate}" Click="CheckUpdate_Click" />
                <MenuItem Header="{local:T MainWindow_MenuAbout}" Click="About_Click" />
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource ToolbarBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,1">
            <StackPanel Orientation="Horizontal" Margin="4,3">
                <Button Style="{StaticResource ToolButton}" Tag="&#xE710;" Click="NewPackage_Click" x:Name="NewPackageButton" Content="{local:T MainWindow_NewPackage}" />
                <Button Style="{StaticResource ToolButton}" Tag="&#xE70F;" Click="EditPackage_Click" x:Name="EditButton" Content="{local:T MainWindow_ToolEdit}" />
                <Border Style="{StaticResource ToolSeparator}" />
                <Button Style="{StaticResource ToolButton}" Tag="&#xE724;" Click="DeployOnce_Click" x:Name="DeployButton" Content="{local:T MainWindow_DeployOnce}" />
                <Button Style="{StaticResource ToolButton}" Tag="&#xE787;" Click="NewSchedule_Click" x:Name="NewScheduleButton" Content="{local:T MainWindow_NewSchedule}" />
                <Border Style="{StaticResource ToolSeparator}" />
                <Button Style="{StaticResource ToolButton}" Tag="&#xE72C;" Click="Refresh_Click" Content="{local:T MainWindow_Refresh}" />
                <Button Style="{StaticResource ToolButton}" Tag="&#xE74D;" Click="DeletePackage_Click" x:Name="DeleteButton" Content="{local:T MainWindow_Delete}" />
                <Border Style="{StaticResource ToolSeparator}" />
                <Button Style="{StaticResource ToolButton}" Tag="&#xE713;" Click="Settings_Click" x:Name="SettingsButton" Content="{local:T MainWindow_ToolPreferences}" />
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource ToolbarBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0">
            <StatusBarItem><TextBlock x:Name="StatusServer" /></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock x:Name="StatusAccount" /></StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right"><TextBlock x:Name="StatusRunning" Margin="0,0,8,0" /></StatusBarItem>
        </StatusBar>

        <!-- Alert banner -->
        <Border x:Name="Banner" DockPanel.Dock="Top" Background="{DynamicResource BannerBackground}" Padding="12,7" Visibility="Collapsed">
            <TextBlock x:Name="BannerText" Foreground="{DynamicResource KoBrush}" TextWrapping="Wrap" />
        </Border>

        <Border x:Name="UpdateBar" DockPanel.Dock="Top" Background="{DynamicResource BannerBackground}" Padding="12,7" Visibility="Collapsed">
            <WrapPanel>
                <TextBlock x:Name="UpdateText" TextWrapping="Wrap" Margin="0,0,18,0" />
                <TextBlock x:Name="UpdateInstall" Margin="0,0,18,0"><Hyperlink Click="UpdateInstall_Click"><Run Text="{local:T MainWindow_UpdateInstallNow}" /></Hyperlink></TextBlock>
                <TextBlock Margin="0,0,18,0"><Hyperlink Click="UpdateLink_Click"><Run Text="{local:T MainWindow_UpdateSeeNew}" /></Hyperlink></TextBlock>
                <TextBlock><Hyperlink Click="UpdateHide_Click"><Run Text="{local:T MainWindow_UpdateHide}" /></Hyperlink></TextBlock>
            </WrapPanel>
        </Border>

        <Grid x:Name="MainArea">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumn" Width="250" MinWidth="180" MaxWidth="800" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation tree -->
            <DockPanel Margin="6">
                <TextBox x:Name="Filter" DockPanel.Dock="Top" Margin="0,0,0,6" TextChanged="Filter_TextChanged"
                         ToolTip="{local:T MainWindow_FilterTip}" />
                <TreeView x:Name="Nav" SelectedItemChanged="Nav_SelectedItemChanged" BorderBrush="{DynamicResource PanelBorder}"
                          MouseDoubleClick="Nav_MouseDoubleClick" Padding="2,4" />
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Style="{StaticResource NavSplitter}"
                          DragCompleted="NavSplitter_DragCompleted" MouseDoubleClick="NavSplitter_DoubleClick"
                          ToolTip="{local:T MainWindow_SplitterTip}" />

            <Grid Grid.Column="2" Margin="6,8,10,8">

                <!-- Home -->
                <DockPanel x:Name="HomeView" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Style="{StaticResource ViewIcon}" Text="&#xE80F;" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource ViewTitle}" Text="{local:T MainWindow_Home}" />
                            <TextBlock Style="{StaticResource ViewSubtitle}" Text="{local:T MainWindow_HomeSubtitle}" />
                        </StackPanel>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <WrapPanel>
                            <Border Style="{StaticResource HomeCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource HomeCardTitle}" Text="{local:T MainWindow_HomeNow}" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource HomeNumber}" x:Name="HomeRunning" Foreground="{DynamicResource RunBrush}" />
                                        <TextBlock x:Name="HomeRunningText" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="240" />
                                    </StackPanel>
                                    <TextBlock x:Name="HomeTargetsText" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,8" TextWrapping="Wrap" />
                                    <TextBlock><Hyperlink Click="HomeDeployments_Click"><Run Text="{local:T MainWindow_HomeSeeDeployments}" /></Hyperlink></TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HomeCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource HomeCardTitle}" Text="{local:T MainWindow_HomeLast24h}" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource HomeNumber}" x:Name="HomeSucceeded" Foreground="{DynamicResource OkBrush}" />
                                        <TextBlock Text="{local:T MainWindow_HomeSucceeded}" VerticalAlignment="Center" Margin="0,0,18,0" />
                                        <TextBlock Style="{StaticResource HomeNumber}" x:Name="HomeFailed" Foreground="{DynamicResource KoBrush}" />
                                        <TextBlock Text="{local:T MainWindow_HomeFailed}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel x:Name="HomeFailures" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HomeCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource HomeCardTitle}" Text="{local:T MainWindow_HomeNextSchedules}" />
                                    <StackPanel x:Name="HomeSchedules" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HomeCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource HomeCardTitle}" Text="{local:T MainWindow_Library}" />
                                    <TextBlock x:Name="HomeLibraryText" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <TextBlock><Hyperlink Click="HomeLibrary_Click"><Run Text="{local:T MainWindow_HomeOpenLibrary}" /></Hyperlink></TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HomeCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource HomeCardTitle}" Text="{local:T MainWindow_HomeShortcuts}" />
                                    <TextBlock Margin="0,0,0,4"><Hyperlink Click="NewPackage_Click"><Run Text="{local:T MainWindow_NewPackage}" /></Hyperlink><Run Foreground="{DynamicResource MutedBrush}" Text="   Ctrl+N" /></TextBlock>
                                    <TextBlock Margin="0,0,0,4"><Hyperlink Click="NewFolder_Click"><Run Text="{local:T MainWindow_NewFolder}" /></Hyperlink><Run Foreground="{DynamicResource MutedBrush}" Text="   " /><Run Foreground="{DynamicResource MutedBrush}" Text="{local:T MainWindow_KeyCtrlShiftF}" /></TextBlock>
                                    <TextBlock Margin="0,0,0,4"><Hyperlink Click="NewSchedule_Click"><Run Text="{local:T MainWindow_NewSchedule}" /></Hyperlink><Run Foreground="{DynamicResource MutedBrush}" Text="   " /><Run Foreground="{DynamicResource MutedBrush}" Text="{local:T MainWindow_KeyCtrlShiftN}" /></TextBlock>
                                    <TextBlock Margin="0,0,0,4"><Hyperlink Click="Import_Click"><Run Text="{local:T MainWindow_ImportPackages}" /></Hyperlink></TextBlock>
                                    <TextBlock><Hyperlink Click="Settings_Click"><Run Text="{local:T MainWindow_HomePreferences}" /></Hyperlink><Run Foreground="{DynamicResource MutedBrush}" Text="   Ctrl+," /></TextBlock>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- All deployments -->
                <DockPanel x:Name="DeploymentsView" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource ViewIcon}" Text="&#xE81C;" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource ViewTitle}" Text="{local:T MainWindow_AllDeployments}" />
                            <TextBlock Style="{StaticResource ViewSubtitle}" Text="{local:T MainWindow_DeploymentsSubtitle}" />
                        </StackPanel>
                    </StackPanel>
                    <local:DeploymentsPanel x:Name="AllDeployments" ShowPackageColumn="True" />
                </DockPanel>

                <!-- All schedules -->
                <DockPanel x:Name="SchedulesView" Visibility="Collapsed">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource HeaderButton}" Click="RunSchedule_Click" x:Name="RunScheduleButton" FontWeight="SemiBold">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{local:T MainWindow_StartNow}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource HeaderButton}" Click="NewSchedule_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{local:T MainWindow_NewSchedule}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ViewIcon}" Text="&#xE787;" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource ViewTitle}" Text="{local:T MainWindow_AllSchedules}" />
                                <TextBlock x:Name="SchedulesSubtitle" Style="{StaticResource ViewSubtitle}" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="SchedulesGrid" MinHeight="64" MaxHeight="190" MouseDoubleClick="EditSchedule_Click" SelectionChanged="SchedulesGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{local:T MainWindow_ColNumber}" Binding="{Binding Id}" Width="50" />
                                <DataGridTextColumn Header="{local:T MainWindow_ColName}" Binding="{Binding Name}" Width="190" />
                                <DataGridTextColumn Header="{local:T MainWindow_ColEnabled}" Binding="{Binding Enabled}" Width="85" />
                                <DataGridTextColumn Header="{local:T MainWindow_ColTriggers}" Binding="{Binding Triggers}" Width="*" />
                                <DataGridTextColumn Header="{local:T MainWindow_ColNextRun}" Binding="{Binding Next}" Width="165" SortMemberPath="NextUtc" />
                                <DataGridTextColumn Header="{local:T MainWindow_ColStartsIn}" Binding="{Binding Countdown}" Width="130" SortMemberPath="NextUtc" />
                                <DataGridTextColumn Header="{local:T MainWindow_ColLastRun}" Binding="{Binding Last}" Width="165" SortMemberPath="LastUtc" />
                                <DataGridTextColumn Header="{local:T MainWindow_ColLastResult}" Binding="{Binding Result}" Width="260" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <local:DeploymentsPanel Grid.Row="2" x:Name="ScheduleDeployments" ShowPackageColumn="True" />
                    </Grid>
                </DockPanel>

                <!-- Package library -->
                <DockPanel x:Name="LibraryView" Visibility="Collapsed">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource HeaderButton}" Click="LibraryDownload_Click" x:Name="LibraryDownloadButton" FontWeight="SemiBold">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="LibraryDownloadText" Text="{local:T MainWindow_Download}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource HeaderButton}" Click="LibraryRefresh_Click" x:Name="LibraryRefreshButton">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{local:T MainWindow_RefreshCatalog}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource HeaderButton}" Click="LibraryFolder_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{local:T MainWindow_FolderDots}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ViewIcon}" Text="&#xE8F1;" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource ViewTitle}" Text="{local:T MainWindow_Library}" />
                                <TextBlock x:Name="LibrarySubtitle" Style="{StaticResource ViewSubtitle}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center" Margin="2,0,8,0" />
                        <TextBox x:Name="LibrarySearch" TextChanged="LibrarySearch_TextChanged"
                                 ToolTip="{local:T MainWindow_LibrarySearchTip}" />
                    </DockPanel>
                    <TextBlock x:Name="LibraryFolderText" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{local:T MainWindow_LibraryNewVersionLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="LibraryAutoUpdateBox" MinWidth="300" SelectionChanged="LibraryAutoUpdate_Changed"
                                  ToolTip="{local:T MainWindow_LibraryAutoUpdateTip}">
                            <ComboBoxItem Tag="Manual" Content="{local:T MainWindow_LibraryAutoManual}" />
                            <ComboBoxItem Tag="Immediate" Content="{local:T MainWindow_LibraryAutoImmediate}" />
                            <ComboBoxItem Tag="Delayed" Content="{local:T MainWindow_LibraryAutoDelayed}" />
                        </ComboBox>
                        <TextBox x:Name="LibraryAutoUpdateDays" Style="{StaticResource CompactBox}" Width="50" Margin="8,0,6,0" LostFocus="LibraryAutoUpdate_Changed"
                                 ToolTip="{local:T MainWindow_LibraryDelayTip}" />
                        <TextBlock x:Name="LibraryAutoUpdateDaysText" Text="{local:T MainWindow_LibraryDaysAfterRelease}" VerticalAlignment="Center" />
                    </StackPanel>
                    <DataGrid x:Name="LibraryGrid" SelectionMode="Extended" MouseDoubleClick="LibraryDownload_Click" SelectionChanged="LibraryGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{local:T MainWindow_ColSoftware}" Binding="{Binding Name}" Width="220" />
                            <DataGridTextColumn Header="{local:T MainWindow_ColIdentifier}" Binding="{Binding Id}" Width="200" />
                            <DataGridTextColumn Header="{local:T MainWindow_ColAvailableVersion}" Binding="{Binding Latest}" Width="140" />
                            <DataGridTextColumn Header="{local:T MainWindow_ColInDeployCraft}" Binding="{Binding Downloaded}" Width="130" />
                            <DataGridTextColumn Header="{local:T MainWindow_ColInstaller}" Binding="{Binding Installer}" Width="110" />
                            <DataGridTextColumn Header="{local:T MainWindow_ColState}" Binding="{Binding State}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <!-- Package -->
                <DockPanel x:Name="PackageView" Visibility="Collapsed">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource HeaderButton}" Click="DeployOnce_Click" FontWeight="SemiBold">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE724;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{local:T MainWindow_DeployOnceDots}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource HeaderButton}" Click="EditPackage_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{local:T MainWindow_EditPackage}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ViewIcon}" Text="&#xE7B8;" />
                            <StackPanel>
                                <TextBlock x:Name="PackageTitle" Style="{StaticResource ViewTitle}" />
                                <TextBlock x:Name="PackageSubtitle" Style="{StaticResource ViewSubtitle}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>

                    <TabControl Padding="10">
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Accent}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{local:T MainWindow_Details}" />
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Grid x:Name="PackageDetailsGrid">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                    <TextBlock Margin="0,12,0,0"><Hyperlink Click="EditPackage_Click"><Run Text="{local:T MainWindow_EditSettingsLink}" /></Hyperlink></TextBlock>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                    <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Accent}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{local:T MainWindow_Deployments}" />
                                </StackPanel>
                            </TabItem.Header>
                            <local:DeploymentsPanel x:Name="PackageDeployments" ShowPackageColumn="False" />
                        </TabItem>
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                    <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Accent}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{local:T MainWindow_Steps}" />
                                </StackPanel>
                            </TabItem.Header>
                            <DataGrid x:Name="StepsGrid" MouseDoubleClick="EditPackage_Click">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{local:T MainWindow_ColNumber}" Binding="{Binding Number}" Width="40" />
                                    <DataGridTextColumn Header="{local:T MainWindow_ColStep}" Binding="{Binding Name}" Width="220" />
                                    <DataGridTextColumn Header="{local:T MainWindow_ColType}" Binding="{Binding Type}" Width="100" />
                                    <DataGridTextColumn Header="{local:T MainWindow_ColConditions}" Binding="{Binding Conditions}" Width="90" />
                                    <DataGridTextColumn Header="{local:T MainWindow_Details}" Binding="{Binding Details}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                    <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Accent}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{local:T MainWindow_Schedules}" />
                                </StackPanel>
                            </TabItem.Header>
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Click="NewScheduleForPackage_Click" Content="{local:T MainWindow_NewScheduleDots}" />
                                    <TextBlock x:Name="PackageSchedulesCount" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                                </DockPanel>
                                <DataGrid x:Name="PackageSchedulesGrid" MouseDoubleClick="EditPackageSchedule_Click">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{local:T MainWindow_ColNumber}" Binding="{Binding Id}" Width="50" />
                                        <DataGridTextColumn Header="{local:T MainWindow_ColName}" Binding="{Binding Name}" Width="190" />
                                        <DataGridTextColumn Header="{local:T MainWindow_ColEnabled}" Binding="{Binding Enabled}" Width="85" />
                                        <DataGridTextColumn Header="{local:T MainWindow_ColTriggers}" Binding="{Binding Triggers}" Width="*" />
                                        <DataGridTextColumn Header="{local:T MainWindow_ColNextRun}" Binding="{Binding Next}" Width="165" />
                                        <DataGridTextColumn Header="{local:T MainWindow_ColStartsIn}" Binding="{Binding Countdown}" Width="130" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
