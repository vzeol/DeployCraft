<Window x:Class="DeployCraft.Console.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeployCraft.Console"
        Title="DeployCraft" Height="820" Width="1360" MinHeight="520" MinWidth="980"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <!-- En-tête de vue : grosse icône + titre + sous-titre -->
        <Style x:Key="ViewIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="2,0,12,0" />
        </Style>
        <Style x:Key="ViewTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ViewSubtitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Padding" Value="12,6" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Menu -->
        <Menu DockPanel.Dock="Top" Padding="2">
            <MenuItem Header="_Fichier" SubmenuOpened="Menu_Opened">
                <MenuItem Header="_Nouveau paquet" Click="NewPackage_Click" InputGestureText="Ctrl+N" x:Name="MenuNewPackage" />
                <Separator />
                <MenuItem Header="D_upliquer le paquet" Click="Duplicate_Click" InputGestureText="Alt+Inser" x:Name="MenuDuplicate" />
                <MenuItem Header="_Modifier le paquet…" Click="EditPackage_Click" InputGestureText="Ctrl+O" x:Name="MenuOpen" />
                <Separator />
                <MenuItem Header="_Déployer une fois…" Click="DeployOnce_Click" InputGestureText="Ctrl+D" x:Name="MenuDeployOnce" />
                <MenuItem Header="Nouvelle _planification…" Click="NewSchedule_Click" InputGestureText="Ctrl+Maj+N" x:Name="MenuNewSchedule" />
                <Separator />
                <MenuItem Header="_Quitter" Click="Exit_Click" InputGestureText="Alt+F4" />
            </MenuItem>
            <MenuItem Header="_Édition" SubmenuOpened="Menu_Opened" x:Name="MenuEdit">
                <MenuItem Header="_Annuler le déploiement" Click="Abort_Click" x:Name="MenuAbort" />
                <Separator />
                <MenuItem Header="_Redéployer" Click="Redeploy_Click" InputGestureText="Ctrl+R" x:Name="MenuRedeploy" />
                <MenuItem Header="Redéployer sur les postes en _échec" Click="RedeployFailed_Click" InputGestureText="Ctrl+Maj+R" x:Name="MenuRedeployFailed" />
                <MenuItem Header="Redéployer depuis l'é_tape en échec" Click="RedeployFromStep_Click" x:Name="MenuRedeployFromStep" />
                <Separator />
                <MenuItem Header="_Supprimer" Click="Delete_Click" InputGestureText="Suppr" x:Name="MenuDelete" />
                <MenuItem Header="Re_nommer le paquet" Click="Rename_Click" InputGestureText="F2" x:Name="MenuRename" />
            </MenuItem>
            <MenuItem Header="_Affichage">
                <MenuItem Header="_Actualiser" Click="Refresh_Click" InputGestureText="F5" />
            </MenuItem>
            <MenuItem Header="_Options" x:Name="MenuOptions">
                <MenuItem Header="_Identifiants…" Click="Credentials_Click" />
                <MenuItem Header="_Utilisateurs de la console…" Click="ConsoleUsers_Click" />
                <Separator />
                <MenuItem Header="_Préférences…" Click="Settings_Click" InputGestureText="Ctrl+," />
            </MenuItem>
            <MenuItem Header="Ai_de">
                <MenuItem Header="Ouvrir une _invite de commandes (admin)" Click="AdminCmd_Click" />
                <MenuItem Header="Ouvrir _PowerShell (admin)" Click="AdminPowerShell_Click" />
                <Separator />
                <MenuItem Header="_À propos de DeployCraft" Click="About_Click" />
            </MenuItem>
        </Menu>

        <!-- Barre d'outils -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource ToolbarBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,1">
            <StackPanel Orientation="Horizontal" Margin="4,3">
                <Button Style="{StaticResource ToolButton}" Tag="&#xE710;" Click="NewPackage_Click" x:Name="NewPackageButton">Nouveau paquet</Button>
                <Button Style="{StaticResource ToolButton}" Tag="&#xE70F;" Click="EditPackage_Click" x:Name="EditButton">Modifier</Button>
                <Border Style="{StaticResource ToolSeparator}" />
                <Button Style="{StaticResource ToolButton}" Tag="&#xE724;" Click="DeployOnce_Click" x:Name="DeployButton">Déployer une fois</Button>
                <Button Style="{StaticResource ToolButton}" Tag="&#xE787;" Click="NewSchedule_Click" x:Name="NewScheduleButton">Nouvelle planification</Button>
                <Border Style="{StaticResource ToolSeparator}" />
                <Button Style="{StaticResource ToolButton}" Tag="&#xE72C;" Click="Refresh_Click">Actualiser</Button>
                <Button Style="{StaticResource ToolButton}" Tag="&#xE74D;" Click="DeletePackage_Click" x:Name="DeleteButton">Supprimer</Button>
                <Border Style="{StaticResource ToolSeparator}" />
                <Button Style="{StaticResource ToolButton}" Tag="&#xE713;" Click="Settings_Click" x:Name="SettingsButton">Réglages</Button>
            </StackPanel>
        </Border>

        <!-- Barre d'état -->
        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource ToolbarBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0">
            <StatusBarItem><TextBlock x:Name="StatusServer" /></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock x:Name="StatusAccount" /></StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right"><TextBlock x:Name="StatusRunning" Margin="0,0,8,0" /></StatusBarItem>
        </StatusBar>

        <!-- Bandeau d'alerte -->
        <Border x:Name="Banner" DockPanel.Dock="Top" Background="{DynamicResource BannerBackground}" Padding="12,7" Visibility="Collapsed">
            <TextBlock x:Name="BannerText" Foreground="{DynamicResource KoBrush}" TextWrapping="Wrap" />
        </Border>

        <Grid x:Name="MainArea">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="180" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Arbre de navigation -->
            <DockPanel Margin="6">
                <TextBox x:Name="Filter" DockPanel.Dock="Top" Margin="0,0,0,6" TextChanged="Filter_TextChanged"
                         ToolTip="Filtrer les paquets" />
                <TreeView x:Name="Nav" SelectedItemChanged="Nav_SelectedItemChanged" BorderBrush="{DynamicResource PanelBorder}"
                          MouseDoubleClick="Nav_MouseDoubleClick" Padding="2,4" />
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <Grid Grid.Column="2" Margin="6,8,10,8">

                <!-- Tous les déploiements -->
                <DockPanel x:Name="DeploymentsView">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource ViewIcon}" Text="&#xE81C;" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource ViewTitle}" Text="Tous les déploiements" />
                            <TextBlock Style="{StaticResource ViewSubtitle}" Text="Historique de tous les paquets, le plus récent en premier" />
                        </StackPanel>
                    </StackPanel>
                    <local:DeploymentsPanel x:Name="AllDeployments" ShowPackageColumn="True" />
                </DockPanel>

                <!-- Toutes les planifications -->
                <DockPanel x:Name="SchedulesView" Visibility="Collapsed">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource HeaderButton}" Click="RunSchedule_Click" x:Name="RunScheduleButton" FontWeight="SemiBold">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Démarrer maintenant" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource HeaderButton}" Click="NewSchedule_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Nouvelle planification" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ViewIcon}" Text="&#xE787;" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource ViewTitle}" Text="Toutes les planifications" />
                                <TextBlock x:Name="SchedulesSubtitle" Style="{StaticResource ViewSubtitle}" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="SchedulesGrid" MinHeight="64" MaxHeight="190" MouseDoubleClick="EditSchedule_Click" SelectionChanged="SchedulesGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="N°" Binding="{Binding Id}" Width="50" />
                                <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="190" />
                                <DataGridTextColumn Header="Activée" Binding="{Binding Enabled}" Width="85" />
                                <DataGridTextColumn Header="Déclencheurs" Binding="{Binding Triggers}" Width="*" />
                                <DataGridTextColumn Header="Prochaine exécution" Binding="{Binding Next}" Width="165" SortMemberPath="NextUtc" />
                                <DataGridTextColumn Header="Départ" Binding="{Binding Countdown}" Width="130" SortMemberPath="NextUtc" />
                                <DataGridTextColumn Header="Dernière exécution" Binding="{Binding Last}" Width="165" SortMemberPath="LastUtc" />
                                <DataGridTextColumn Header="Dernier résultat" Binding="{Binding Result}" Width="260" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <local:DeploymentsPanel Grid.Row="2" x:Name="ScheduleDeployments" ShowPackageColumn="True" />
                    </Grid>
                </DockPanel>

                <!-- Paquet -->
                <DockPanel x:Name="PackageView" Visibility="Collapsed">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource HeaderButton}" Click="DeployOnce_Click" FontWeight="SemiBold">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE724;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Déployer une fois…" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource HeaderButton}" Click="EditPackage_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Modifier le paquet" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ViewIcon}" Text="&#xE7B8;" />
                            <StackPanel>
                                <TextBlock x:Name="PackageTitle" Style="{StaticResource ViewTitle}" />
                                <TextBlock x:Name="PackageSubtitle" Style="{StaticResource ViewSubtitle}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>

                    <TabControl Padding="10">
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                    <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Accent}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Déploiements" />
                                </StackPanel>
                            </TabItem.Header>
                            <local:DeploymentsPanel x:Name="PackageDeployments" ShowPackageColumn="False" />
                        </TabItem>
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                    <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Accent}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Étapes" />
                                </StackPanel>
                            </TabItem.Header>
                            <DataGrid x:Name="StepsGrid" MouseDoubleClick="EditPackage_Click">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="N°" Binding="{Binding Number}" Width="40" />
                                    <DataGridTextColumn Header="Étape" Binding="{Binding Name}" Width="220" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100" />
                                    <DataGridTextColumn Header="Détails" Binding="{Binding Details}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                    <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Accent}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Planifications" />
                                </StackPanel>
                            </TabItem.Header>
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Click="NewScheduleForPackage_Click">Nouvelle planification…</Button>
                                    <TextBlock x:Name="PackageSchedulesCount" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                                </DockPanel>
                                <DataGrid x:Name="PackageSchedulesGrid" MouseDoubleClick="EditPackageSchedule_Click">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="N°" Binding="{Binding Id}" Width="50" />
                                        <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="190" />
                                        <DataGridTextColumn Header="Activée" Binding="{Binding Enabled}" Width="85" />
                                        <DataGridTextColumn Header="Déclencheurs" Binding="{Binding Triggers}" Width="*" />
                                        <DataGridTextColumn Header="Prochaine exécution" Binding="{Binding Next}" Width="165" />
                                        <DataGridTextColumn Header="Départ" Binding="{Binding Countdown}" Width="130" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
