<UserControl x:Class="DeployCraft.Console.DeploymentsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DeployCraft.Console">
    <UserControl.Resources>
        <local:StatusTextConverter x:Key="StatusText" />
        <local:StatusBrushConverter x:Key="StatusBrush" />
        <local:StatusIconConverter x:Key="StatusIcon" />

        <DataTemplate x:Key="StatusCell">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Status, Converter={StaticResource StatusIcon}}" FontFamily="{StaticResource IconFont}"
                           Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Status, Converter={StaticResource StatusText}}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <!-- Details card to the right of the grids -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ContentBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style x:Key="CardSection" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,7,0,2" />
        </Style>
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Margin" Value="0,1,10,1" />
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FilterBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="220" />
            <Setter Property="ToolTip" Value="{local:T DeploymentsPanel_Filter}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="140" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" MinHeight="140" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- ======= Deployments ======= -->
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBox x:Name="DeploymentFilter" DockPanel.Dock="Right" Style="{StaticResource FilterBox}" TextChanged="DeploymentFilter_TextChanged" />
                <TextBlock x:Name="DeploymentsTitle" Style="{StaticResource SectionTitle}" />
            </DockPanel>
            <DataGrid x:Name="DeploymentsGrid" SelectionChanged="DeploymentsGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{local:T DeploymentsPanel_ColNumber}" Binding="{Binding Id}" Width="55" />
                    <DataGridTemplateColumn Header="{local:T DeploymentsPanel_Status}" CellTemplate="{StaticResource StatusCell}" Width="110" SortMemberPath="Status" />
                    <DataGridTextColumn x:Name="PackageColumn" Header="{local:T DeploymentsPanel_Package}" Binding="{Binding PackageName}" Width="*" MinWidth="120" />
                    <DataGridTextColumn Header="{local:T DeploymentsPanel_Launched}" Binding="{Binding Created}" Width="140" SortMemberPath="CreatedUtc" />
                    <DataGridTextColumn Header="{local:T DeploymentsPanel_Duration}" Binding="{Binding Duration}" Width="90" />
                    <DataGridTextColumn Header="{local:T DeploymentsPanel_Computers}" Binding="{Binding Counts.Total}" Width="75" />
                    <DataGridTextColumn Header="{local:T DeploymentsPanel_ColPriority}" Binding="{Binding Prioritized}" Width="95" />
                    <DataGridTextColumn Header="{local:T DeploymentsPanel_Waiting}" Binding="{Binding Counts.Queued}" Width="95" />
                    <DataGridTextColumn Header="{local:T DeploymentsPanel_Running}" Binding="{Binding Counts.Running}" Width="85" />
                    <DataGridTextColumn Header="{local:T DeploymentsPanel_ColSucceeded}" Binding="{Binding Counts.Successful}" Width="80" />
                    <DataGridTextColumn Header="{local:T DeploymentsPanel_Failures}" Binding="{Binding Counts.Failed}" Width="75" />
                    <DataGridTextColumn Header="{local:T DeploymentsPanel_ColCancelled}" Binding="{Binding Counts.Aborted}" Width="80" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <Border Grid.Column="2" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <TextBlock x:Name="NoDeployment" Text="{local:T DeploymentsPanel_SelectDeployment}" Foreground="{DynamicResource MutedBrush}" />
                    <StackPanel x:Name="DeploymentDetails" Visibility="Collapsed">
                        <TextBlock Text="{local:T DeploymentsPanel_DeploymentDetailsTitle}" Style="{StaticResource CardSection}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="DStatusIcon" FontFamily="{StaticResource IconFont}" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <StackPanel>
                                <TextBlock x:Name="DTitle" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="DStatus" FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{local:T DeploymentsPanel_Summary}" Style="{StaticResource CardSection}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource CardLabel}" Text="{local:T DeploymentsPanel_Package}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource CardValue}" x:Name="DPackage" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Style="{StaticResource CardLabel}" Text="{local:T DeploymentsPanel_Launched}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource CardValue}" x:Name="DCreated" />
                            <TextBlock Grid.Row="2" Style="{StaticResource CardLabel}" Text="{local:T DeploymentsPanel_Duration}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource CardValue}" x:Name="DDuration" />
                            <TextBlock Grid.Row="3" Style="{StaticResource CardLabel}" Text="{local:T DeploymentsPanel_LaunchedBy}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource CardValue}" x:Name="DLaunchedBy" />
                            <TextBlock Grid.Row="4" Style="{StaticResource CardLabel}" Text="{local:T DeploymentsPanel_Account}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource CardValue}" x:Name="DRunAs" />
                            <TextBlock Grid.Row="5" Style="{StaticResource CardLabel}" Text="{local:T DeploymentsPanel_Computers}" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource CardValue}">
                                <Run x:Name="DTotal" />
                                <Hyperlink x:Name="RedeployLink" Click="RedeployAll_Click"><Run Text="{local:T DeploymentsPanel_Redeploy}" /></Hyperlink>
                            </TextBlock>
                            <TextBlock Grid.Row="6" Style="{StaticResource CardLabel}" Text="{local:T DeploymentsPanel_Failures}" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource CardValue}">
                                <Run x:Name="DFailed" />
                                <Hyperlink x:Name="RetryLink" Click="RedeployFailed_Click"><Run Text="{local:T DeploymentsPanel_Retry}" /></Hyperlink>
                            </TextBlock>
                        </Grid>
                        <TextBlock x:Name="DCounts" Foreground="{DynamicResource RunBrush}" Margin="0,6,0,0" />

                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <GridSplitter Grid.Row="1" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- ======= Computers of the selected deployment ======= -->
        <DockPanel Grid.Row="2">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBox x:Name="TargetFilter" DockPanel.Dock="Right" Style="{StaticResource FilterBox}" TextChanged="TargetFilter_TextChanged" />
                <TextBlock x:Name="TargetsTitle" Style="{StaticResource SectionTitle}" />
            </DockPanel>
            <DataGrid x:Name="TargetsGrid" SelectionMode="Extended" SelectionChanged="TargetsGrid_SelectionChanged" MouseDoubleClick="TargetsGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{local:T DeploymentsPanel_Deployment}" Binding="{Binding DeploymentId}" Width="110" />
                    <DataGridTextColumn Header="{local:T DeploymentsPanel_Computer}" Binding="{Binding Computer}" Width="160" />
                    <DataGridTemplateColumn Header="{local:T DeploymentsPanel_Status}" CellTemplate="{StaticResource StatusCell}" Width="110" SortMemberPath="Status" />
                    <DataGridTextColumn Header="{local:T DeploymentsPanel_Steps}" Binding="{Binding Steps}" Width="Auto" MinWidth="90" />
                    <DataGridTextColumn Binding="{Binding Detail}" Width="*" MinWidth="220">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{local:T DeploymentsPanel_Detail}" ToolTip="{local:T DeploymentsPanel_DetailTip}" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="{local:T DeploymentsPanel_Start}" Binding="{Binding Started}" Width="140" />
                    <DataGridTextColumn Header="{local:T DeploymentsPanel_Duration}" Binding="{Binding Duration}" Width="80" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <TextBlock x:Name="NoTarget" Text="{local:T DeploymentsPanel_SelectComputer}" Foreground="{DynamicResource MutedBrush}" />
                    <StackPanel x:Name="TargetDetails" Visibility="Collapsed">
                        <TextBlock Text="{local:T DeploymentsPanel_ComputerDetailsTitle}" Style="{StaticResource CardSection}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE977;" FontFamily="{StaticResource IconFont}" FontSize="26" Foreground="{DynamicResource Accent}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <StackPanel>
                                <TextBlock x:Name="TName" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="TStatus" FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{local:T DeploymentsPanel_Summary}" Style="{StaticResource CardSection}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition x:Name="TCurrentRow" /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource CardLabel}" Text="{local:T DeploymentsPanel_Steps}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource CardValue}">
                                <Hyperlink Click="ShowSteps_Click"><Run x:Name="TSteps" /></Hyperlink>
                            </TextBlock>
                            <TextBlock Grid.Row="1" Style="{StaticResource CardLabel}" Text="{local:T DeploymentsPanel_Running}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource CardValue}" x:Name="TCurrent" Foreground="{DynamicResource RunBrush}" />
                            <TextBlock Grid.Row="2" Style="{StaticResource CardLabel}" Text="{local:T DeploymentsPanel_Start}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource CardValue}" x:Name="TStarted" />
                            <TextBlock Grid.Row="3" Style="{StaticResource CardLabel}" Text="{local:T DeploymentsPanel_End}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource CardValue}" x:Name="TEnded" />
                            <TextBlock Grid.Row="4" Style="{StaticResource CardLabel}" Text="{local:T DeploymentsPanel_Duration}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource CardValue}" x:Name="TDuration" />
                            <TextBlock Grid.Row="5" Style="{StaticResource CardLabel}" Text="{local:T DeploymentsPanel_Action}" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource CardValue}">
                                <Hyperlink Click="RedeployTarget_Click"><Run Text="{local:T DeploymentsPanel_RedeployOnComputer}" /></Hyperlink>
                            </TextBlock>
                        </Grid>

                        <!-- "ERREUR" in red for a failed computer; "REMARQUE" for the reason given on a successful computer. -->
                        <TextBlock x:Name="TErrorTitle" Text="{local:T DeploymentsPanel_ErrorTitle}" Style="{StaticResource CardSection}" AutomationProperties.Name="{local:T DeploymentsPanel_ErrorTitle}" />
                        <TextBlock x:Name="TError" TextWrapping="Wrap" Foreground="{DynamicResource KoBrush}" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
