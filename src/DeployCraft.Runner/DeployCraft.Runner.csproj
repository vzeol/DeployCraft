<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runner copié temporairement sur chaque PC cible.
    Cible .NET Framework 4.8, présent d'origine sur Windows 10/11 :
    rien à installer sur les postes.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <!-- Also restored for win-x64 (service publish): the lock file stays the same in both cases. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>DeployCraft.Runner</AssemblyName>
    <RootNamespace>DeployCraft.Runner</RootNamespace>
  </PropertyGroup>

  <!-- .NET Framework 4.8 reference assemblies as a package: same compilation (and same lock file) with or without the 4.8 pack installed. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

</Project>
