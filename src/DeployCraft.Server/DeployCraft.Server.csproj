<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Published as self-contained win-x64 (build.ps1): the lock file includes this runtime. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DeployCraft.Server</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Messages: Texts\Msg.resx in French, Msg.en.resx in English. -->
    <NeutralLanguage>fr</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.13" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
    <PackageReference Include="System.DirectoryServices" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeployCraft.Tests" />
  </ItemGroup>

  <!-- The runner (net48) is built before the server then copied into runner\ next to the server. -->
  <ItemGroup>
    <ProjectReference Include="..\DeployCraft.Runner\DeployCraft.Runner.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <Target Name="CopyRunner" AfterTargets="Build;Publish">
    <ItemGroup>
      <RunnerFiles Include="..\DeployCraft.Runner\bin\$(Configuration)\net48\DeployCraft.Runner.exe;..\DeployCraft.Runner\bin\$(Configuration)\net48\DeployCraft.Runner.exe.config" />
    </ItemGroup>
    <Copy SourceFiles="@(RunnerFiles)" DestinationFolder="$(OutDir)runner" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(RunnerFiles)" DestinationFolder="$(PublishDir)runner" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != ''" />
  </Target>

</Project>
