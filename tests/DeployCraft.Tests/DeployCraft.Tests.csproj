<Project Sdk="Microsoft.NET.Sdk">

  <!-- Automated tests: service logic testable without network or computers (dotnet test DeployCraft.slnx). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DeployCraft.Server\DeployCraft.Server.csproj" />
    <!-- The console logic (lists, details, refresh) is tested too: it needs the WPF framework. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <!-- Alias: the console compiles its own copy of the server models; its types are only reached through ConsoleApp::. -->
    <ProjectReference Include="..\..\src\DeployCraft.Console\DeployCraft.Console.csproj" Aliases="ConsoleApp" />
  </ItemGroup>

  <!-- Conditions and step sequencing of the runner (.NET Framework, on the computers): same files, tested here. -->
  <ItemGroup>
    <Compile Include="..\..\src\DeployCraft.Runner\Job.cs" Link="Runner\Job.cs" />
    <Compile Include="..\..\src\DeployCraft.Runner\Conditions.cs" Link="Runner\Conditions.cs" />
    <Compile Include="..\..\src\DeployCraft.Runner\StepSequence.cs" Link="Runner\StepSequence.cs" />
    <Compile Include="..\..\src\DeployCraft.Runner\FileCopy.cs" Link="Runner\FileCopy.cs" />
    <Compile Include="..\..\src\DeployCraft.Runner\Shutdown.cs" Link="Runner\Shutdown.cs" />
    <Compile Include="..\..\src\DeployCraft.Runner\MessageOutcome.cs" Link="Runner\MessageOutcome.cs" />
    <Compile Include="..\..\src\DeployCraft.Runner\InstallLog.cs" Link="Runner\InstallLog.cs" />
    <Compile Include="..\..\src\DeployCraft.Runner\ProcessOutput.cs" Link="Runner\ProcessOutput.cs" />
    <Compile Include="..\..\src\DeployCraft.Runner\RunnerTexts.cs" Link="Runner\RunnerTexts.cs" />
    <Compile Include="..\..\src\DeployCraft.Runner\Steps\*.cs" Link="Runner\Steps\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
